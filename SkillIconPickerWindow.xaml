<Window x:Class="RoAura.SkillIconPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:RoAura.Converters"
        Title="{DynamicResource SkillIconCatalogTitle}" Width="650" Height="560" MinWidth="440" MinHeight="340"
        PreviewMouseDown="Picker_PreviewMouseDown" Deactivated="Picker_Deactivated" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <converters:Base64ToImageSourceConverter x:Key="SkillIconImage"/>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource RoBorderBrush}" BorderThickness="1" CornerRadius="9" Background="{DynamicResource UiBackground_F2F6FC}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Padding="12,6" CornerRadius="8,8,0,0" Background="{DynamicResource RoTitleBrush}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="&#x2715;" Width="30" Height="26" MinHeight="0" Padding="0"
                            Click="ClosePicker_Click" ToolTip="{DynamicResource Cancel}"/>
                    <TextBlock x:Name="CatalogHeading" Text="{DynamicResource SkillIconCatalogTitle}" Style="{StaticResource RoSectionTitleStyle}" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <TabControl x:Name="EquipmentCatalogTabs" DockPanel.Dock="Top" Visibility="Collapsed" Margin="12,6,12,0"
                        Style="{StaticResource SectionTabControlStyle}" SelectionChanged="EquipmentCatalogTabs_SelectionChanged">
                <TabItem x:Name="ItemIconsTab" Header="{DynamicResource EquipmentItemIconSearch}"/>
                <TabItem Header="{DynamicResource EquipmentSkillIconSearch}"/>
            </TabControl>
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="IconSearchField" Margin="0,0,10,0">
                        <TextBlock x:Name="SearchLabel" Text="{DynamicResource SkillIconSearchLabel}" Margin="0,0,0,4"/>
                        <TextBox x:Name="SearchBox" TextChanged="FilterChanged" AutomationProperties.LabeledBy="{Binding ElementName=SearchLabel}"/>
                    </StackPanel>
                    <StackPanel x:Name="SkillJobFilters" Grid.Column="1">
                        <TextBlock x:Name="JobLabel" Text="{DynamicResource SkillIconJobSearch}" Margin="0,0,0,4"/>
                        <Grid x:Name="JobField" PreviewMouseLeftButtonDown="JobField_PreviewMouseLeftButtonDown">
                            <TextBox x:Name="JobEditor" Padding="8,4,32,4" TextChanged="JobEditor_TextChanged"
                                     PreviewKeyDown="JobEditor_PreviewKeyDown"
                                     AutomationProperties.LabeledBy="{Binding ElementName=JobLabel}"/>
                            <Border x:Name="JobArrow" HorizontalAlignment="Right" Width="30" Background="Transparent">
                                <Path Style="{StaticResource RoDropdownChevronStyle}" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                            </Border>
                            <Popup x:Name="JobPopup" PlacementTarget="{Binding ElementName=JobField}" Placement="Bottom"
                                   AllowsTransparency="True">
                                <Border Width="{Binding ActualWidth, ElementName=JobField}" MaxHeight="260" Padding="3"
                                        Background="{DynamicResource RoPanelBrush}" BorderBrush="{DynamicResource RoBorderBrush}"
                                        BorderThickness="1" CornerRadius="5">
                                    <ListBox x:Name="JobOptions" Focusable="False" BorderThickness="0"
                                             PreviewMouseLeftButtonUp="JobOptions_MouseLeftButtonUp"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <WrapPanel Margin="0,6,0,0">
                            <CheckBox x:Name="RebirthBox" Content="Rebirth" IsChecked="True" Click="JobEditionChanged" Margin="0,0,12,0"/>
                            <CheckBox x:Name="RenewalBox" Content="Renewal" IsChecked="True" Click="JobEditionChanged"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
                <ListBox Grid.Row="1" x:Name="Results" SelectionChanged="SelectionChanged" MouseDoubleClick="ResultDoubleClicked"
                         VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="5,4">
                                <Image Source="{Binding IconBase64, Converter={StaticResource SkillIconImage}}" Width="30" Height="30"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Identifier}" Foreground="{DynamicResource RoMutedBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Grid.Row="1" Text="{DynamicResource SkillIconNoResults}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="{DynamicResource Cancel}" IsCancel="True"/>
                    <Button x:Name="ChooseButton" Content="{DynamicResource SkillIconUse}" Click="Choose_Click" IsDefault="True"
                            Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
