<Window x:Class="RoAura.MarketWatchDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{DynamicResource WatchAddTitle}" Width="500" SizeToContent="Height" MinWidth="420" MinHeight="280"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F6F9FE" Foreground="#17365F">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBox x:Name="ItemSearch" Padding="8" TextChanged="Search_Changed" PreviewKeyDown="Search_KeyDown" ToolTip="{DynamicResource WatchSearchHint}"/>
  <ListBox x:Name="Suggestions" IsSynchronizedWithCurrentItem="False" Grid.Row="1" MaxHeight="160" MinHeight="0" Margin="0,6,0,12" Visibility="Collapsed" DisplayMemberPath="Caption" SelectionChanged="Suggestion_Selected" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
  <TextBlock x:Name="SelectedItemLabel" Grid.Row="2" TextWrapping="Wrap" FontWeight="Bold" Margin="0,0,0,10"/>
  <StackPanel Grid.Row="3"><TextBlock Text="{DynamicResource WatchMaximumPrice}"/><TextBox x:Name="PriceBox" Padding="8" Margin="0,4,0,8"/>
   <CheckBox x:Name="WithoutPrice" Content="{DynamicResource WatchWithoutPrice}" Checked="PriceMode_Changed" Unchecked="PriceMode_Changed"/></StackPanel>
  <TextBlock x:Name="ErrorText" Grid.Row="4" Foreground="#B42318" TextWrapping="Wrap" Margin="0,8"/>
  <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="{DynamicResource Cancel}" IsCancel="True" Margin="0,0,10,0"/>
   <Button Content="{DynamicResource Add}" Click="Add_Click"/>
  </StackPanel>
 </Grid>
</Window>
