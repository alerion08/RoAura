<Window x:Class="RoAura.MarketWatchDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RoAura"
 Title="{DynamicResource WatchAddTitle}" Width="400" SizeToContent="Height" MinWidth="360" MinHeight="240" MaxHeight="660"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F6F9FE" Foreground="#17365F">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><local:MarketWatchEditor x:Name="Editor"/></ScrollViewer>
  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
   <Button Content="{DynamicResource Cancel}" IsCancel="True" Margin="0,0,10,0"/>
   <Button x:Name="AddButton" Content="{DynamicResource Add}" Click="Add_Click"/>
  </StackPanel>
 </Grid>
</Window>
