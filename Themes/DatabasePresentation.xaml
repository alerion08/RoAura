<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="Button" BasedOn="{StaticResource RoButtonBaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource DatabaseInk}"/>
        <Setter Property="Background" Value="{DynamicResource DatabaseField}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DatabaseLine}"/>
        <Setter Property="MinHeight" Value="29"/>
        <Setter Property="Padding" Value="9,5"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style x:Key="DatabaseTabItem" TargetType="TabItem" BasedOn="{StaticResource EditorTabItemStyle}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="6,5"/>
        <Setter Property="Foreground" Value="{DynamicResource DatabaseMuted}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Surface" Padding="{TemplateBinding Padding}" BorderThickness="0,0,0,2"
                            BorderBrush="Transparent" Background="Transparent">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource DatabaseRow}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource DatabaseAccent}"/>
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource DatabaseSoft}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="{DynamicResource DatabaseBlue}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="DatabaseResult" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border BorderBrush="{DynamicResource DatabaseLine}" BorderThickness="0,0,0,1">
                        <Border x:Name="Surface" Background="Transparent" BorderThickness="2,0,0,0"
                                BorderBrush="Transparent" CornerRadius="4" Padding="5,4" MinHeight="33">
                            <ContentPresenter/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource DatabaseRow}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource DatabaseRow}"/>
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource DatabaseAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="DatabaseLinkRow" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource DatabaseBlue}"/>
        <Setter Property="Padding" Value="7,5"/>
        <Setter Property="MinHeight" Value="31"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border BorderBrush="{DynamicResource DatabaseLine}" BorderThickness="0,0,0,1">
                        <Border x:Name="Surface" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource DatabaseRow}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
