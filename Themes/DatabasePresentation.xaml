<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="DatabasePanelTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Georgia"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource DatabaseBlue}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="DatabaseActionButton" TargetType="Button">
        <Setter Property="Margin" Value="3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="MinHeight" Value="29"/>
        <Setter Property="Padding" Value="9,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.9"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.78"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource DatabaseActionButton}">
        <Setter Property="Foreground" Value="{DynamicResource DatabaseInk}"/>
        <Setter Property="Background" Value="{DynamicResource DatabaseField}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DatabaseLine}"/>
        <Setter Property="MinHeight" Value="29"/>
        <Setter Property="Padding" Value="9,5"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style x:Key="DatabasePrimaryButton" TargetType="Button" BasedOn="{StaticResource DatabaseActionButton}">
        <Setter Property="Background" Value="#2B61A0"/>
        <Setter Property="BorderBrush" Value="#2B61A0"/>
    </Style>
    <Style x:Key="DatabaseDangerButton" TargetType="Button" BasedOn="{StaticResource DatabaseActionButton}">
        <Setter Property="Background" Value="#B03044"/>
        <Setter Property="BorderBrush" Value="#B03044"/>
    </Style>
    <Style x:Key="DatabaseTabItem" TargetType="TabItem" BasedOn="{StaticResource EditorTabItemStyle}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="6,5"/>
        <Setter Property="Foreground" Value="{DynamicResource DatabaseMuted}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Surface" Padding="{TemplateBinding Padding}" BorderThickness="0,0,0,2"
                            BorderBrush="Transparent" Background="Transparent">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource DatabaseRow}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource DatabaseAccent}"/>
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource DatabaseSoft}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="{DynamicResource DatabaseBlue}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="DatabaseResult" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border BorderBrush="{DynamicResource DatabaseLine}" BorderThickness="0,0,0,1">
                        <Border x:Name="Surface" Background="Transparent" BorderThickness="2,0,0,0"
                                BorderBrush="Transparent" CornerRadius="4" Padding="5,4" MinHeight="33">
                            <ContentPresenter/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource DatabaseRow}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource DatabaseRow}"/>
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource DatabaseAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="DatabaseLinkRow" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource DatabaseBlue}"/>
        <Setter Property="Padding" Value="7,5"/>
        <Setter Property="MinHeight" Value="31"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border BorderBrush="{DynamicResource DatabaseLine}" BorderThickness="0,0,0,1">
                        <Border x:Name="Surface" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource DatabaseRow}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
