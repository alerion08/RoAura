<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:RoAura.Controls">
    <Color x:Key="RoInkColor">#17386B</Color>
    <Color x:Key="RoMutedColor">#667C9D</Color>
    <Color x:Key="RoBlueColor">#2F67B5</Color>
    <Color x:Key="RoDeepBlueColor">#163F7E</Color>
    <Color x:Key="RoGoldColor">#D1A34A</Color>
    <Color x:Key="RoLineColor">#A9C2E2</Color>
    <Color x:Key="RoSoftLineColor">#D5E2F1</Color>

    <SolidColorBrush x:Key="RoWindowBrush" Color="#EAF3FB"/>
    <SolidColorBrush x:Key="RoPanelBrush" Color="#FBFDFF"/>
    <SolidColorBrush x:Key="RoCardBrush" Color="#F9FCFF"/>
    <SolidColorBrush x:Key="RoTextBrush" Color="{StaticResource RoInkColor}"/>
    <SolidColorBrush x:Key="RoMutedBrush" Color="{StaticResource RoMutedColor}"/>
    <SolidColorBrush x:Key="RoBlueBrush" Color="{StaticResource RoBlueColor}"/>
    <SolidColorBrush x:Key="RoDeepBlueBrush" Color="{StaticResource RoDeepBlueColor}"/>
    <SolidColorBrush x:Key="RoGoldBrush" Color="{StaticResource RoGoldColor}"/>
    <SolidColorBrush x:Key="RoBorderBrush" Color="{StaticResource RoLineColor}"/>
    <SolidColorBrush x:Key="RoSoftBorderBrush" Color="{StaticResource RoSoftLineColor}"/>
    <SolidColorBrush x:Key="RoSelectionBrush" Color="#D9E9FC"/>
    <SolidColorBrush x:Key="RoTitleBrush" Color="#DDECF9"/>
    <SolidColorBrush x:Key="RoPinkBrush" Color="#E5A4B7"/>

    <FontFamily x:Key="RoDisplayFont">Palatino Linotype</FontFamily>
    <FontFamily x:Key="RoHeadingFont">Trebuchet MS</FontFamily>
    <FontFamily x:Key="RoBodyFont">Trebuchet MS</FontFamily>

    <LinearGradientBrush x:Key="RoHeaderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F8FCFF" Offset="0"/>
        <GradientStop Color="#DCEBF8" Offset="0.58"/>
        <GradientStop Color="#C9DDF2" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RoButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#EDF5FE" Offset="0.48"/>
        <GradientStop Color="#D4E4F6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RoPrimaryButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#7FAAE2" Offset="0"/>
        <GradientStop Color="#477FC9" Offset="0.52"/>
        <GradientStop Color="#2D64AD" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RoGoldButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF7D7" Offset="0"/>
        <GradientStop Color="#F0D38B" Offset="0.5"/>
        <GradientStop Color="#D7A84E" Offset="1"/>
    </LinearGradientBrush>

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource RoBodyFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource RoTextBrush}"/></Style>
    <Style x:Key="RoDisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RoDisplayFont}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource RoDeepBlueBrush}"/>
    </Style>
    <Style x:Key="RoSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RoDisplayFont}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="Foreground" Value="{StaticResource RoDeepBlueBrush}"/>
    </Style>
    <Style x:Key="RoCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RoHeadingFont}"/>
        <Setter Property="Foreground" Value="{StaticResource RoMutedBrush}"/>
    </Style>
    <Style x:Key="SectionHeaderCardStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Padding" Value="14,9"/>
        <Setter Property="CornerRadius" Value="7"/><Setter Property="Background" Value="#E5F0FC"/>
        <Setter Property="BorderBrush" Value="{StaticResource RoSoftBorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="InfoHintStyle" TargetType="Border">
        <Setter Property="Padding" Value="12,8"/><Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Background" Value="#EAF3FF"/><Setter Property="BorderBrush" Value="{StaticResource RoSoftBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="InfoHintGlyphStyle" TargetType="TextBlock">
        <Setter Property="Text" Value="ⓘ"/><Setter Property="Foreground" Value="{StaticResource RoBlueBrush}"/>
        <Setter Property="FontSize" Value="15"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
    <Style x:Key="DashboardCardStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="Padding" Value="18,15"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Background" Value="{StaticResource RoCardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource RoSoftBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="DashboardValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RoDisplayFont}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource RoDeepBlueBrush}"/>
    </Style>
    <Style x:Key="DashboardLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RoHeadingFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource RoMutedBrush}"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>
    <Style x:Key="WorkspacePanelStyle" TargetType="Border">
        <Setter Property="Padding" Value="8"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{StaticResource RoPanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource RoSoftBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="EditorTabItemStyle" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource RoMutedBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource RoHeadingFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabBorder" Padding="{TemplateBinding Padding}" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="0,0,0,2">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#EDF4FD"/></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource RoBlueBrush}"/>
                            <Setter TargetName="TabBorder" Property="Background" Value="#F5F9FE"/>
                            <Setter Property="Foreground" Value="{StaticResource RoDeepBlueBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="EditorTabControlStyle" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource EditorTabItemStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource RoSoftBorderBrush}" BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" Background="Transparent"/>
                        </Border>
                        <ContentPresenter Content="{TemplateBinding SelectedContent}"
                                          ContentTemplate="{TemplateBinding SelectedContentTemplate}"/>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SectionTabControlStyle" TargetType="TabControl" BasedOn="{StaticResource EditorTabControlStyle}"/>

    <Style x:Key="RoButtonBaseStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource RoDeepBlueBrush}"/>
        <Setter Property="Background" Value="{StaticResource RoButtonBrush}"/>
        <Setter Property="BorderBrush" Value="#789DCF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,3"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="{StaticResource RoHeadingFont}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Shadow" Margin="1,2,0,0" CornerRadius="6" Background="#253F6796"/>
                        <Border x:Name="Outer" Margin="0,0,1,2" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Border Margin="1" CornerRadius="4">
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Border>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Outer" Property="Background" Value="#E2EFFF"/><Setter TargetName="Outer" Property="BorderBrush" Value="#3E74BD"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Outer" Property="Margin" Value="1,2,0,0"/><Setter TargetName="Shadow" Property="Visibility" Value="Hidden"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource RoButtonBaseStyle}"/>
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource RoButtonBaseStyle}"><Setter Property="Background" Value="{StaticResource RoPrimaryButtonBrush}"/><Setter Property="BorderBrush" Value="#1D4F95"/><Setter Property="Foreground" Value="White"/></Style>
    <Style x:Key="GoldButtonStyle" TargetType="Button" BasedOn="{StaticResource RoButtonBaseStyle}"><Setter Property="Background" Value="{StaticResource RoGoldButtonBrush}"/><Setter Property="BorderBrush" Value="#AF7927"/><Setter Property="Foreground" Value="#684719"/></Style>
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource RoButtonBaseStyle}"><Setter Property="Background" Value="#FFF0F1"/><Setter Property="BorderBrush" Value="#C36B75"/><Setter Property="Foreground" Value="#9A3442"/></Style>
    <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource RoButtonBaseStyle}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
    <Style x:Key="TitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource RoButtonBaseStyle}"><Setter Property="Width" Value="36"/><Setter Property="Height" Value="30"/><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="16"/></Style>

    <Style TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource RoDeepBlueBrush}"/><Setter Property="Background" Value="{StaticResource RoButtonBrush}"/>
        <Setter Property="BorderBrush" Value="#789DCF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,3"/>
        <Setter Property="Margin" Value="3"/><Setter Property="MinHeight" Value="32"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{StaticResource RoHeadingFont}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
            <Border x:Name="ToggleBorder" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <Border Margin="2" CornerRadius="4" BorderBrush="#80FFFFFF" BorderThickness="1"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleBorder" Property="Background" Value="#E2EFFF"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource RoPrimaryButtonBrush}"/><Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#1D4F95"/><Setter Property="Foreground" Value="White"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="RoTextBoxStyle" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource RoTextBrush}"/><Setter Property="Background" Value="#FCFEFF"/>
        <Setter Property="BorderBrush" Value="{StaticResource RoSoftBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,4"/>
        <Setter Property="CaretBrush" Value="{StaticResource RoDeepBlueBrush}"/><Setter Property="SelectionBrush" Value="{StaticResource RoSelectionBrush}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
            <Border x:Name="TextBorder" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><!-- TextBoxBase forwards Padding to this ScrollViewer; adding it as Margin clips the text. --><ScrollViewer x:Name="PART_ContentHost"/></Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TextBorder" Property="BorderBrush" Value="#477FC9"/><Setter TargetName="TextBorder" Property="BorderThickness" Value="1"/></Trigger>
                <Trigger Property="IsReadOnly" Value="True"><Setter TargetName="TextBorder" Property="Background" Value="#EDF3F9"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource RoTextBoxStyle}"/>
    <Style TargetType="controls:NumericTextBox" BasedOn="{StaticResource RoTextBoxStyle}"/>
    <Style TargetType="controls:ColorTextBox" BasedOn="{StaticResource RoTextBoxStyle}"/>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource RoTextBrush}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal"><Border x:Name="Box" Width="18" Height="18" CornerRadius="4" Background="White" BorderBrush="#789DCF" BorderThickness="1" VerticalAlignment="Center"><Path x:Name="Tick" Data="M 3 8 L 7 12 L 15 4" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/></Border><ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#2F67B5"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#477FC9"/><Setter TargetName="Box" Property="BorderBrush" Value="#24579E"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="9,6"/><Setter Property="Foreground" Value="{StaticResource RoTextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="VerticalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{StaticResource RoSelectionBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#C7DDF8"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></Style.Triggers></Style>
    <Style x:Key="ComboEditableTextBoxStyle" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource RoTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource RoTextBrush}"/><Setter Property="Background" Value="#FCFEFF"/><Setter Property="BorderBrush" Value="{StaticResource RoSoftBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,4"/><Setter Property="MinHeight" Value="30"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
            <Grid><Border x:Name="ComboBorder" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                <ContentPresenter x:Name="SelectedContent" Margin="9,3,32,3" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                <TextBox x:Name="PART_EditableTextBox" Style="{StaticResource ComboEditableTextBoxStyle}" Margin="9,0,32,0" VerticalContentAlignment="Center" Visibility="Hidden" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                <ToggleButton x:Name="DropButton" Style="{x:Null}" Background="Transparent" BorderThickness="0" Margin="0" Padding="0" MinHeight="0" Width="30" HorizontalAlignment="Right" Focusable="False" FocusVisualStyle="{x:Null}"
                    IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><Path HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 5 5 L 10 0" Stroke="{StaticResource RoBlueBrush}" StrokeThickness="1.8"/></Border></ControlTemplate></ToggleButton.Template>
                </ToggleButton>
                <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade"><Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320" Margin="0,4,0,0" Padding="3" CornerRadius="6" Background="White" BorderBrush="#789DCF" BorderThickness="1"><ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer></Border></Popup>
            </Grid>
            <ControlTemplate.Triggers><Trigger Property="IsEditable" Value="True"><Setter TargetName="SelectedContent" Property="Visibility" Value="Hidden"/><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="#477FC9"/><Setter TargetName="ComboBorder" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{StaticResource RoDeepBlueBrush}"/>
        <Setter Property="Background" Value="{StaticResource RoCardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource RoSoftBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource RoHeadingFont}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border CornerRadius="8" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Padding="12,8" Background="#EAF3FF" CornerRadius="7,7,0,0"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1">
                                <ContentPresenter ContentSource="Header" TextElement.FontWeight="Bold"
                                                  TextElement.FontFamily="{StaticResource RoHeadingFont}"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" Margin="12"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGrid"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource RoTextBrush}"/><Setter Property="RowBackground" Value="#FCFEFF"/><Setter Property="AlternatingRowBackground" Value="#F2F7FC"/><Setter Property="BorderBrush" Value="{StaticResource RoBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E1EAF5"/><Setter Property="VerticalGridLinesBrush" Value="Transparent"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="SelectionUnit" Value="FullRow"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Height" Value="38"/><Setter Property="Background" Value="#DCEAF8"/><Setter Property="Foreground" Value="{StaticResource RoDeepBlueBrush}"/><Setter Property="Padding" Value="10,5"/><Setter Property="BorderBrush" Value="#C0D3E9"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="FontFamily" Value="{StaticResource RoHeadingFont}"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style TargetType="DataGridRow"><Setter Property="MinHeight" Value="40"/><Setter Property="Foreground" Value="{StaticResource RoTextBrush}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E9F2FC"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource RoSelectionBrush}"/><Setter Property="Foreground" Value="{StaticResource RoDeepBlueBrush}"/></Trigger></Style.Triggers></Style>
    <Style TargetType="DataGridCell"><Setter Property="Padding" Value="9,5"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Background" Value="Transparent"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource RoDeepBlueBrush}"/></Trigger></Style.Triggers></Style>

    <Style TargetType="Thumb"><Setter Property="Background" Value="#86A9D5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="5" Margin="2"/></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ScrollBar"><Setter Property="Width" Value="12"/><Setter Property="Background" Value="#E1EBF6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb MinHeight="24"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" Orientation="Horizontal" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb MinWidth="24"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Trigger></Style.Triggers></Style>
        <Style x:Key="RoSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="28" ClipToBounds="True" SnapsToDevicePixels="True">
                            <Border Height="6" Margin="8,0" VerticalAlignment="Center" Background="#D2DFEF" CornerRadius="3"/>
                            <Track x:Name="PART_Track" Height="18" Margin="8,0" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="6" VerticalAlignment="Center" Background="{StaticResource RoBlueBrush}" CornerRadius="3"/></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16">
                                        <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#FFF8FC" BorderBrush="{StaticResource RoBlueBrush}" BorderThickness="2" CornerRadius="8"/></ControlTemplate></Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    <Style TargetType="Slider" BasedOn="{StaticResource RoSliderStyle}"/>
    <Style TargetType="Separator"><Setter Property="Height" Value="1"/><Setter Property="Background" Value="{StaticResource RoSoftBorderBrush}"/><Setter Property="Margin" Value="0,6"/></Style>
</ResourceDictionary>
