<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:RoAura.Controls">
    <Color x:Key="RoInkColor">#17386B</Color>
    <Color x:Key="RoMutedColor">#667C9D</Color>
    <Color x:Key="RoBlueColor">#2F67B5</Color>
    <Color x:Key="RoDeepBlueColor">#163F7E</Color>
    <Color x:Key="RoGoldColor">#D1A34A</Color>
    <Color x:Key="RoLineColor">#A9C2E2</Color>
    <Color x:Key="RoSoftLineColor">#D5E2F1</Color>

    <SolidColorBrush x:Key="RoWindowBrush" Color="{DynamicResource UiColor_EAF3FB}"/>
    <SolidColorBrush x:Key="RoPanelBrush" Color="{DynamicResource UiColor_FBFDFF}"/>
    <SolidColorBrush x:Key="RoCardBrush" Color="{DynamicResource UiColor_F9FCFF}"/>
    <SolidColorBrush x:Key="RoTextBrush" Color="{DynamicResource RoInkColor}"/>
    <SolidColorBrush x:Key="RoMutedBrush" Color="{DynamicResource RoMutedColor}"/>
    <SolidColorBrush x:Key="RoBlueBrush" Color="{DynamicResource RoBlueColor}"/>
    <SolidColorBrush x:Key="RoDeepBlueBrush" Color="{DynamicResource RoDeepBlueColor}"/>
    <SolidColorBrush x:Key="RoGoldBrush" Color="{DynamicResource RoGoldColor}"/>
    <SolidColorBrush x:Key="RoBorderBrush" Color="{DynamicResource RoLineColor}"/>
    <SolidColorBrush x:Key="RoSoftBorderBrush" Color="{DynamicResource RoSoftLineColor}"/>
    <SolidColorBrush x:Key="RoSelectionBrush" Color="{DynamicResource UiColor_D9E9FC}"/>
    <SolidColorBrush x:Key="RoTitleBrush" Color="{DynamicResource UiColor_DDECF9}"/>
    <SolidColorBrush x:Key="RoPinkBrush" Color="{DynamicResource UiColor_E5A4B7}"/>

    <FontFamily x:Key="RoDisplayFont">Palatino Linotype</FontFamily>
    <FontFamily x:Key="RoHeadingFont">Trebuchet MS</FontFamily>
    <FontFamily x:Key="RoBodyFont">Trebuchet MS</FontFamily>

    <LinearGradientBrush x:Key="RoHeaderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource UiColor_F8FCFF}" Offset="0"/>
        <GradientStop Color="{DynamicResource UiColor_DCEBF8}" Offset="0.58"/>
        <GradientStop Color="{DynamicResource UiColor_C9DDF2}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RoButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource UiColor_FFFFFF}" Offset="0"/>
        <GradientStop Color="{DynamicResource UiColor_EDF5FE}" Offset="0.48"/>
        <GradientStop Color="{DynamicResource UiColor_D4E4F6}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RoPrimaryButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource UiColor_7FAAE2}" Offset="0"/>
        <GradientStop Color="{DynamicResource UiColor_477FC9}" Offset="0.52"/>
        <GradientStop Color="{DynamicResource UiColor_2D64AD}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RoGoldButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource UiColor_FFF7D7}" Offset="0"/>
        <GradientStop Color="{DynamicResource UiColor_F0D38B}" Offset="0.5"/>
        <GradientStop Color="{DynamicResource UiColor_D7A84E}" Offset="1"/>
    </LinearGradientBrush>

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource RoBodyFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="{DynamicResource RoCardBrush}"/><Setter Property="Foreground" Value="{DynamicResource RoTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource RoSoftBorderBrush}"/></Style>
    <Style TargetType="ListView"><Setter Property="Background" Value="{DynamicResource RoCardBrush}"/><Setter Property="Foreground" Value="{DynamicResource RoTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource RoSoftBorderBrush}"/></Style>
    <Style TargetType="ContextMenu"><Setter Property="Background" Value="{DynamicResource RoCardBrush}"/><Setter Property="Foreground" Value="{DynamicResource RoTextBrush}"/></Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource RoTextBrush}"/></Style>
    <Style x:Key="RoDisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RoDisplayFont}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource RoDeepBlueBrush}"/>
    </Style>
    <Style x:Key="RoSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RoDisplayFont}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="Foreground" Value="{DynamicResource RoDeepBlueBrush}"/>
    </Style>
    <Style x:Key="RoCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RoHeadingFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource RoMutedBrush}"/>
    </Style>
    <Style x:Key="SectionHeaderCardStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Padding" Value="14,9"/>
        <Setter Property="CornerRadius" Value="7"/><Setter Property="Background" Value="{DynamicResource UiBackground_E5F0FC}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource RoSoftBorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="InfoHintStyle" TargetType="Border">
        <Setter Property="Padding" Value="12,8"/><Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Background" Value="{DynamicResource UiBackground_EAF3FF}"/><Setter Property="BorderBrush" Value="{DynamicResource RoSoftBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="InfoHintGlyphStyle" TargetType="TextBlock">
        <Setter Property="Text" Value="ⓘ"/><Setter Property="Foreground" Value="{DynamicResource RoBlueBrush}"/>
        <Setter Property="FontSize" Value="15"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
    <Style x:Key="DashboardCardStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="Padding" Value="18,15"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Background" Value="{DynamicResource RoCardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource RoSoftBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="DashboardValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RoDisplayFont}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource RoDeepBlueBrush}"/>
    </Style>
    <Style x:Key="DashboardLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RoHeadingFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource RoMutedBrush}"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>
    <Style x:Key="WorkspacePanelStyle" TargetType="Border">
        <Setter Property="Padding" Value="8"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{DynamicResource RoPanelBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource RoSoftBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="EditorTabItemStyle" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource RoMutedBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource RoHeadingFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabBorder" Padding="{TemplateBinding Padding}" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="0,0,0,2">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource UiBackground_EDF4FD}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource RoBlueBrush}"/>
                            <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource UiBackground_F5F9FE}"/>
                            <Setter Property="Foreground" Value="{DynamicResource RoDeepBlueBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="EditorTabControlStyle" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource EditorTabItemStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource RoSoftBorderBrush}" BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" Background="Transparent"/>
                        </Border>
                        <ContentPresenter Content="{TemplateBinding SelectedContent}"
                                          ContentTemplate="{TemplateBinding SelectedContentTemplate}"/>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SectionTabControlStyle" TargetType="TabControl" BasedOn="{StaticResource EditorTabControlStyle}"/>

    <Style x:Key="RoButtonBaseStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource RoDeepBlueBrush}"/>
        <Setter Property="Background" Value="{DynamicResource RoButtonBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource UiBorder_789DCF}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,3"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="{StaticResource RoHeadingFont}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Shadow" Margin="1,2,0,0" CornerRadius="6" Background="{DynamicResource UiBackground_253F6796}"/>
                        <Border x:Name="Outer" Margin="0,0,1,2" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Border Margin="1" CornerRadius="4">
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Border>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Outer" Property="Background" Value="{DynamicResource UiBackground_E2EFFF}"/><Setter TargetName="Outer" Property="BorderBrush" Value="{DynamicResource UiBorder_3E74BD}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Outer" Property="Margin" Value="1,2,0,0"/><Setter TargetName="Shadow" Property="Visibility" Value="Hidden"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource RoButtonBaseStyle}"/>
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource RoButtonBaseStyle}"><Setter Property="Background" Value="{DynamicResource RoPrimaryButtonBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource UiBorder_1D4F95}"/><Setter Property="Foreground" Value="{DynamicResource UiForeground_FFFFFF}"/></Style>
    <Style x:Key="GoldButtonStyle" TargetType="Button" BasedOn="{StaticResource RoButtonBaseStyle}"><Setter Property="Background" Value="{DynamicResource RoGoldButtonBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource UiBorder_AF7927}"/><Setter Property="Foreground" Value="{DynamicResource UiForeground_684719}"/></Style>
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource RoButtonBaseStyle}"><Setter Property="Background" Value="{DynamicResource UiBackground_FFF0F1}"/><Setter Property="BorderBrush" Value="{DynamicResource UiBorder_C36B75}"/><Setter Property="Foreground" Value="{DynamicResource UiForeground_9A3442}"/></Style>
    <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource RoButtonBaseStyle}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
    <Style x:Key="TitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource RoButtonBaseStyle}"><Setter Property="Width" Value="36"/><Setter Property="Height" Value="30"/><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="16"/></Style>

    <Style TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource RoDeepBlueBrush}"/><Setter Property="Background" Value="{DynamicResource RoButtonBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource UiBorder_789DCF}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,3"/>
        <Setter Property="Margin" Value="3"/><Setter Property="MinHeight" Value="32"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{StaticResource RoHeadingFont}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
            <Border x:Name="ToggleBorder" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <Border Margin="2" CornerRadius="4" BorderBrush="{DynamicResource UiBorder_80FFFFFF}" BorderThickness="1"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource UiBackground_E2EFFF}"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource RoPrimaryButtonBrush}"/><Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource UiBorder_1D4F95}"/><Setter Property="Foreground" Value="{DynamicResource UiForeground_FFFFFF}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="RoTextBoxStyle" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource RoTextBrush}"/><Setter Property="Background" Value="{DynamicResource UiBackground_FCFEFF}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource RoSoftBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,4"/>
        <Setter Property="CaretBrush" Value="{DynamicResource RoDeepBlueBrush}"/><Setter Property="SelectionBrush" Value="{DynamicResource RoSelectionBrush}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
            <Border x:Name="TextBorder" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><!-- TextBoxBase forwards Padding to this ScrollViewer; adding it as Margin clips the text. --><ScrollViewer x:Name="PART_ContentHost"/></Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TextBorder" Property="BorderBrush" Value="{DynamicResource UiBorder_477FC9}"/><Setter TargetName="TextBorder" Property="BorderThickness" Value="1"/></Trigger>
                <Trigger Property="IsReadOnly" Value="True"><Setter TargetName="TextBorder" Property="Background" Value="{DynamicResource UiBackground_EDF3F9}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource RoTextBoxStyle}"/>
    <Style TargetType="controls:NumericTextBox" BasedOn="{StaticResource RoTextBoxStyle}"/>
    <Style TargetType="controls:ColorTextBox" BasedOn="{StaticResource RoTextBoxStyle}"/>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource RoTextBrush}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal"><Border x:Name="Box" Width="18" Height="18" CornerRadius="4" Background="{DynamicResource UiBackground_FFFFFF}" BorderBrush="{DynamicResource UiBorder_789DCF}" BorderThickness="1" VerticalAlignment="Center"><Path x:Name="Tick" Data="M 3 8 L 7 12 L 15 4" Stroke="{DynamicResource UiForeground_FFFFFF}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/></Border><ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource UiBorder_2F67B5}"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource UiBackground_477FC9}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource UiBorder_24579E}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="9,6"/><Setter Property="Foreground" Value="{DynamicResource RoTextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="VerticalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource RoSelectionBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource UiBackground_C7DDF8}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></Style.Triggers></Style>
    <Style x:Key="ComboEditableTextBoxStyle" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource RoTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource RoTextBrush}"/><Setter Property="Background" Value="{DynamicResource UiBackground_FCFEFF}"/><Setter Property="BorderBrush" Value="{DynamicResource RoSoftBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,4"/><Setter Property="MinHeight" Value="30"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
            <Grid><Border x:Name="ComboBorder" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                <ContentPresenter x:Name="SelectedContent" Margin="9,3,32,3" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                <TextBox x:Name="PART_EditableTextBox" Style="{StaticResource ComboEditableTextBoxStyle}" Margin="9,0,32,0" VerticalContentAlignment="Center" Visibility="Hidden" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                <ToggleButton x:Name="DropButton" Style="{x:Null}" Background="Transparent" BorderThickness="0" Margin="0" Padding="0" MinHeight="0" Focusable="False" FocusVisualStyle="{x:Null}"
                    IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent">
                                <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                      Data="M 0 0 L 5 5 L 10 0" Stroke="{DynamicResource RoBlueBrush}" StrokeThickness="1.8"/>
                            </Border>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade"><Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320" Margin="0,4,0,0" Padding="3" CornerRadius="6" Background="{DynamicResource UiBackground_FFFFFF}" BorderBrush="{DynamicResource UiBorder_789DCF}" BorderThickness="1"><ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer></Border></Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEditable" Value="True">
                    <Setter TargetName="SelectedContent" Property="Visibility" Value="Hidden"/>
                    <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="DropButton" Property="Width" Value="30"/>
                    <Setter TargetName="DropButton" Property="HorizontalAlignment" Value="Right"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource UiBorder_477FC9}"/>
                    <Setter TargetName="ComboBorder" Property="BorderThickness" Value="1"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="QuestBetaBadgeStyle" TargetType="Border">
        <Setter Property="Padding" Value="5,1"/>
        <Setter Property="Margin" Value="7,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource RoSoftBorderBrush}"/>
        <Setter Property="Background" Value="{DynamicResource RoSelectionBrush}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource RoDeepBlueBrush}"/>
        <Setter Property="Background" Value="{DynamicResource RoCardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource RoSoftBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource RoHeadingFont}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border CornerRadius="8" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Padding="12,8" Background="{DynamicResource UiBackground_EAF3FF}" CornerRadius="7,7,0,0"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1">
                                <ContentPresenter ContentSource="Header" TextElement.FontWeight="Bold"
                                                  TextElement.FontFamily="{StaticResource RoHeadingFont}"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" Margin="12"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGrid"><Setter Property="Background" Value="{DynamicResource UiBackground_FFFFFF}"/><Setter Property="Foreground" Value="{DynamicResource RoTextBrush}"/><Setter Property="RowBackground" Value="{DynamicResource UiBackground_FCFEFF}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource UiBackground_F2F7FC}"/><Setter Property="BorderBrush" Value="{DynamicResource RoBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource RoSoftBorderBrush}"/><Setter Property="VerticalGridLinesBrush" Value="Transparent"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="SelectionUnit" Value="FullRow"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Height" Value="38"/><Setter Property="Background" Value="{DynamicResource UiBackground_DCEAF8}"/><Setter Property="Foreground" Value="{DynamicResource RoDeepBlueBrush}"/><Setter Property="Padding" Value="10,5"/><Setter Property="BorderBrush" Value="{DynamicResource UiBorder_C0D3E9}"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="FontFamily" Value="{StaticResource RoHeadingFont}"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style TargetType="DataGridRow"><Setter Property="MinHeight" Value="40"/><Setter Property="Foreground" Value="{DynamicResource RoTextBrush}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource UiBackground_E9F2FC}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource RoSelectionBrush}"/><Setter Property="Foreground" Value="{DynamicResource RoDeepBlueBrush}"/></Trigger></Style.Triggers></Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
            </Border>
        </ControlTemplate></Setter.Value></Setter>
        <Setter Property="Padding" Value="9,5"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Background" Value="Transparent"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource RoDeepBlueBrush}"/></Trigger></Style.Triggers></Style>

    <Style TargetType="Thumb"><Setter Property="Background" Value="{DynamicResource UiBackground_86A9D5}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="5" Margin="2"/></ControlTemplate></Setter.Value></Setter></Style>
