<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:RoAura.Converters">
    <converters:ColorStringToBrushConverter x:Key="TimerPanelColorBrush"/>
    <converters:DoubleToThicknessConverter x:Key="TimerPanelThickness"/>
    <Style x:Key="TimerOverlayActionStyle" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#01000000"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#40FFFFFF"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TimerPanelFrameStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="10"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding TimersShowBackground}" Value="True">
                <Setter Property="Background">
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource TimerPanelColorBrush}">
                            <Binding Path="TimersBackgroundColor"/>
                            <Binding Path="TimersBackgroundOpacityPercent"/>
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding TimersShowBorder}" Value="True">
                <Setter Property="BorderBrush" Value="{Binding TimersBorderColor, Converter={StaticResource TimerPanelColorBrush}}"/>
                <Setter Property="BorderThickness" Value="{Binding TimersBorderThickness, Converter={StaticResource TimerPanelThickness}}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
