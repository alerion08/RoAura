<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RoAura</AssemblyName>
    <DefineConstants Condition="'$(RoAuraDevelopment)' == 'true'">$(DefineConstants);ROAURA_DEV</DefineConstants>
    <RootNamespace>RoAura</RootNamespace>
    <!--
      Single source of truth for the product version. build-release.ps1,
      build-installer.ps1 (-> installer.iss), release.yml and AboutWindow all
      read it from here. The only other copy is app.manifest/assemblyIdentity,
      which MSBuild cannot substitute; keep it in sync manually.
    -->
    <Version>3.2.0</Version>
    <AssemblyVersion>3.2.0.0</AssemblyVersion>
    <FileVersion>3.2.0.0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <Company>Alerion</Company>
    <Authors>Alerion</Authors>
    <Product>RoAura</Product>
    <Copyright>© 2026 Alerion</Copyright>
    <Description>Windows overlay for Ragnarok Online: cooldowns, buffs, MVP timers, loot and market tracking via Npcap.</Description>
    <RepositoryUrl>https://github.com/alerion08/RoAura</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Embedded PDB: crash stack traces keep line numbers without shipping a separate .pdb. -->
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Analyzer style rules are informational only; warnings never fail the build. -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\roaura.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="RoAura.Tests\**\*.cs" />
    <EmbeddedResource Remove="RoAura.Tests\**\*" />
    <None Remove="RoAura.Tests\**\*" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\roaura.ico" />
    <Resource Include="Assets\roaura-icon.png" />
    <Resource Include="Assets\roaura-logo.png" />
    <Resource Include="Assets\twitch.png" />
    <Resource Include="Assets\discord.png" />
    <Resource Include="Assets\donate.png" />
    <Resource Include="Assets\Menu\*.png" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Data\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Data\*.sqlite">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Data\MvpImages\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
