<Window x:Class="RoAura.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обновление RoAura" Icon="Assets/roaura.ico"
        Width="560" Height="470" MinWidth="500" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource RoWindowBrush}" Foreground="{StaticResource RoTextBrush}">
    <Border Margin="8" Padding="18" CornerRadius="9" Background="{StaticResource RoPanelBrush}"
            BorderBrush="{StaticResource RoBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Image Source="Assets/roaura-icon.png" Width="72" Height="72" Margin="0,0,14,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="Доступно обновление" Style="{StaticResource RoSectionTitleStyle}" FontSize="21"/>
                    <TextBlock x:Name="VersionText" Margin="0,5,0,0" FontSize="14" Foreground="{StaticResource RoMutedBrush}"/>
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="DescriptionText" Grid.Row="1" Margin="0,14,0,7" TextWrapping="Wrap"/>
            <Border Grid.Row="2" Background="#F7FBFF" BorderBrush="{StaticResource RoSoftBorderBrush}" BorderThickness="1" CornerRadius="5">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="11">
                    <TextBlock x:Name="NotesText" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>
            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <ProgressBar x:Name="DownloadProgress" Height="15" Minimum="0" Maximum="100" Visibility="Collapsed"/>
                <TextBlock x:Name="StatusText" Margin="0,5,0,0" Foreground="{StaticResource RoMutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="LaterButton" Content="Позже" Width="105" Click="Later_Click"/>
                <Button x:Name="InstallButton" Content="Обновить" Width="125" Style="{StaticResource PrimaryButtonStyle}" Click="Install_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
