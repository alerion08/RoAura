<UserControl x:Class="RoAura.QuestSettingsControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:RoAura.Controls">
 <UserControl.Resources><Style x:Key="QuestCard" TargetType="Border" BasedOn="{StaticResource WorkspacePanelStyle}"><Setter Property="Margin" Value="0,0,6,8"/></Style><Style x:Key="QuestNumber" TargetType="controls:NumericTextBox" BasedOn="{StaticResource RoTextBoxStyle}"><Setter Property="Width" Value="80"/><Setter Property="Margin" Value="8,3,14,3"/></Style></UserControl.Resources>
 <Grid x:Name="SettingsRoot" Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Border Style="{StaticResource SectionHeaderCardStyle}"><StackPanel><TextBlock Text="ROQuestie" Style="{StaticResource RoSectionTitleStyle}"/><TextBlock Text="{DynamicResource QGameFirst}" TextWrapping="Wrap"/></StackPanel></Border>
 <StackPanel Grid.Row="1"><WrapPanel><Button Content="{DynamicResource QOpenBrowser}" Click="Open_Click"/><Button Content="{DynamicResource QToggleTracker}" Click="Tracker_Click"/><Button Content="{DynamicResource QMoveTracker}" Click="Move_Click"/></WrapPanel><TextBlock x:Name="GameStatus" TextWrapping="Wrap" Margin="0,4"/></StackPanel>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,8,6,0">
     <Border Style="{StaticResource QuestCard}"><StackPanel DataContext="{Binding Settings.QuestOverlay}">
      <CheckBox Content="{DynamicResource QOverlayEnabled}" IsChecked="{Binding Enabled}"/>
      <WrapPanel Margin="0,8"><TextBlock Text="X" VerticalAlignment="Center"/><controls:NumericTextBox Value="{Binding X, Mode=TwoWay}" Style="{StaticResource QuestNumber}"/><TextBlock Text="Y" VerticalAlignment="Center"/><controls:NumericTextBox Value="{Binding Y, Mode=TwoWay}" Style="{StaticResource QuestNumber}"/><TextBlock Text="{DynamicResource QClientCoordinates}" TextWrapping="Wrap" VerticalAlignment="Center"/></WrapPanel>
      <WrapPanel><TextBlock Text="{DynamicResource QWidth}" VerticalAlignment="Center"/><controls:NumericTextBox Value="{Binding Width, Mode=TwoWay}" Style="{StaticResource QuestNumber}"/><TextBlock Text="{DynamicResource QFontSize}" VerticalAlignment="Center"/><controls:NumericTextBox Value="{Binding FontSize, Mode=TwoWay}" Style="{StaticResource QuestNumber}"/></WrapPanel>
      <WrapPanel><TextBlock Text="{DynamicResource QOpacity}" VerticalAlignment="Center"/><controls:NumericTextBox Value="{Binding OpacityPercent, Mode=TwoWay}" Style="{StaticResource QuestNumber}"/><TextBlock Text="{DynamicResource QGap}" VerticalAlignment="Center"/><controls:NumericTextBox Value="{Binding CardGap, Mode=TwoWay}" Style="{StaticResource QuestNumber}"/><TextBlock Text="{DynamicResource QScale}" VerticalAlignment="Center"/><controls:NumericTextBox Value="{Binding Scale, Mode=TwoWay}" Style="{StaticResource QuestNumber}"/></WrapPanel>
      <WrapPanel><TextBlock Text="{DynamicResource QTextColor}" VerticalAlignment="Center"/><controls:ColorTextBox Style="{StaticResource RoTextBoxStyle}" Text="{Binding TextColor, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="8,4"/><CheckBox Content="{DynamicResource QShowCoordinates}" IsChecked="{Binding ShowCoordinates}" VerticalAlignment="Center" Margin="12,4"/><CheckBox Content="{DynamicResource QShowButtons}" IsChecked="{Binding ShowButtons}" VerticalAlignment="Center" Margin="12,4"/></WrapPanel>
     </StackPanel></Border>
     <Border Style="{StaticResource InfoHintStyle}" Margin="0,0,0,8"><StackPanel><TextBlock Text="{DynamicResource QOverlayStage}" TextWrapping="Wrap"/><TextBlock Text="{DynamicResource QHotkeyHint}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
     <TextBlock Text="{DynamicResource QPreview}" Style="{StaticResource RoSectionTitleStyle}"/>
     <Border Background="#6C8298" CornerRadius="6" Padding="12" HorizontalAlignment="Left" MaxWidth="660" Margin="0,8,0,0"><Viewbox Stretch="Uniform" StretchDirection="DownOnly"><StackPanel x:Name="PreviewPanel"/></Viewbox></Border>
    </StackPanel></ScrollViewer>
   
 </Grid></UserControl>