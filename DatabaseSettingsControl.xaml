<UserControl x:Class="RoAura.DatabaseSettingsControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:RoAura.Controls" xmlns:converters="clr-namespace:RoAura.Converters" LostKeyboardFocus="Settings_LostFocus">
 <UserControl.Resources>
  <converters:ColorStringToBrushConverter x:Key="WatchColorBrush"/>
  <converters:DoubleToThicknessConverter x:Key="WatchPadding"/>
 </UserControl.Resources>
 <TabControl Margin="8" Style="{StaticResource SectionTabControlStyle}">
  <TabItem Header="{DynamicResource BasicTab}"><Grid Margin="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Padding="16" CornerRadius="8" Background="#E5F0FC" BorderBrush="{StaticResource RoSoftBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource DatabaseTitle}" FontSize="20"/>
                                <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Text="{DynamicResource DatabaseDescription}"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="18" VerticalAlignment="Top">
                            <TextBlock Text="{DynamicResource DatabaseHotkeyTitle}" FontFamily="Georgia" FontWeight="Bold" FontSize="17" Foreground="{StaticResource RoBlueBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <ComboBox Width="100" ItemsSource="{Binding HotkeyChoices}" SelectedItem="{Binding DatabaseHotkey, Mode=TwoWay}"/>
                                <Button Content="{DynamicResource OpenDatabase}" Margin="10,0,0,0" Click="OpenDatabase_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <TextBlock Text="{DynamicResource MarketRefreshInterval}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <controls:NumericTextBox Width="80" Value="{Binding MarketBackgroundRefreshMinutes, Mode=TwoWay}"/>
                            </StackPanel>
                            <TextBlock Margin="0,12,0,0" Foreground="#A34C13" TextWrapping="Wrap" Text="{DynamicResource MarketRefreshWarning}"/>
                            <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" Foreground="{StaticResource RoMutedBrush}" Text="{DynamicResource DatabaseInputHint}"/>
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource RoMutedBrush}" Text="{DynamicResource DatabaseSearchLimitHint}"/>
                        </StackPanel>
                    </Grid></TabItem>
  <TabItem Header="{DynamicResource WatchListTitle}">
   <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
     <Button Content="{DynamicResource Add}" Click="AddWatch_Click"/>
     <Button Content="{DynamicResource WatchEdit}" Click="EditWatch_Click" Margin="10,0,0,0"/>
     <Button Content="{DynamicResource Delete}" Click="DeleteWatch_Click" Margin="10,0,0,0"/>
    </StackPanel>
    <ListView x:Name="WatchList" Grid.Row="1" ItemsSource="{Binding MarketWatchRules}">
     <ListView.View><GridView><GridViewColumn Header="{DynamicResource Name}" Width="340" DisplayMemberBinding="{Binding Caption}"/>
      <GridViewColumn Header="{DynamicResource WatchPriceRule}" Width="230" DisplayMemberBinding="{Binding PriceCaption}"/></GridView></ListView.View>
    </ListView>
    <TextBlock Grid.Row="2" Text="{DynamicResource WatchListHint}" TextWrapping="Wrap" Margin="0,10,0,0"/>
   </Grid>
  </TabItem>
  <TabItem Header="{DynamicResource NotificationsTab}">
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18" DataContext="{Binding MarketWatchNotifications}">
    <CheckBox Content="{DynamicResource Enabled}" IsChecked="{Binding Enabled}" Margin="0,0,0,12"/>
    <TextBlock Text="{DynamicResource WatchTemplate}"/>
    <TextBox Text="{Binding TextTemplate, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,5"/>
    <TextBlock Text="{DynamicResource WatchTemplateHint}" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <WrapPanel Margin="0,0,0,12"><Button Content="{DynamicResource WatchChooseIcon}" Click="ChooseIcon_Click"/>
     <Button Content="{DynamicResource WatchItemIcon}" Click="ResetIcon_Click" Margin="10,0,0,0"/>
     <Button Content="{DynamicResource WatchPreview}" Click="Preview_Click" Margin="10,0,0,0"/></WrapPanel>
    <Border x:Name="PreviewBorder" Visibility="Collapsed" CornerRadius="6" Margin="0,0,0,12"
      Background="{Binding Background, Converter={StaticResource WatchColorBrush}}" Padding="{Binding Padding, Converter={StaticResource WatchPadding}}">
      <StackPanel Orientation="Horizontal"><Image x:Name="PreviewIcon" Width="{Binding IconSize}" Height="{Binding IconSize}" Margin="0,0,8,0" Stretch="Uniform"/>
       <TextBlock x:Name="PreviewText" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="Bold" MaxWidth="600"
          FontSize="{Binding TextSize}" Foreground="{Binding TextColor, Converter={StaticResource WatchColorBrush}}"/>
      </StackPanel>
    </Border>
    <UniformGrid Columns="2">
     <TextBlock Text="{DynamicResource IconSize}" VerticalAlignment="Center" Margin="0,5"/><controls:NumericTextBox Value="{Binding IconSize, Mode=TwoWay}" Margin="0,5"/>
     <TextBlock Text="{DynamicResource TextSize}" VerticalAlignment="Center" Margin="0,5"/><controls:NumericTextBox Value="{Binding TextSize, Mode=TwoWay}" Margin="0,5"/>
     <TextBlock Text="{DynamicResource IconPadding}" VerticalAlignment="Center" Margin="0,5"/><controls:NumericTextBox Value="{Binding Padding, Mode=TwoWay}" Margin="0,5"/>
     <TextBlock Text="{DynamicResource WatchGap}" VerticalAlignment="Center" Margin="0,5"/><controls:NumericTextBox Value="{Binding Gap, Mode=TwoWay}" Margin="0,5"/>
     <TextBlock Text="{DynamicResource WatchDuration}" VerticalAlignment="Center" Margin="0,5"/><controls:NumericTextBox Value="{Binding DurationSeconds, Mode=TwoWay}" Margin="0,5"/>
     <TextBlock Text="X" VerticalAlignment="Center" Margin="0,5"/><controls:NumericTextBox Value="{Binding X, Mode=TwoWay}" Margin="0,5"/>
     <TextBlock Text="Y" VerticalAlignment="Center" Margin="0,5"/><controls:NumericTextBox Value="{Binding Y, Mode=TwoWay}" Margin="0,5"/>
     <TextBlock Text="{DynamicResource WatchBackground}" VerticalAlignment="Center" Margin="0,5"/><TextBox x:Name="BackgroundEditor" Text="{Binding Background, UpdateSourceTrigger=LostFocus}" LostFocus="Color_LostFocus" Margin="0,5"/>
     <TextBlock Text="{DynamicResource WatchTextColor}" VerticalAlignment="Center" Margin="0,5"/><TextBox x:Name="TextColorEditor" Text="{Binding TextColor, UpdateSourceTrigger=LostFocus}" LostFocus="Color_LostFocus" Margin="0,5"/>
    </UniformGrid>
    <TextBlock Text="{DynamicResource WatchColorHint}" TextWrapping="Wrap" Margin="0,6,0,12"/>
    <CheckBox Content="{DynamicResource WatchSound}" IsChecked="{Binding SoundEnabled}" Margin="0,4"/>
    <DockPanel Margin="0,8,0,0"><Button DockPanel.Dock="Right" Content="{DynamicResource WatchChooseSound}" Click="ChooseSound_Click" Margin="10,0,0,0"/>
     <TextBox Text="{Binding SoundPath, UpdateSourceTrigger=LostFocus}" IsReadOnly="True"/></DockPanel>
   </StackPanel></ScrollViewer>
  </TabItem>
 </TabControl>
</UserControl>
