<UserControl x:Class="RoAura.DatabaseSettingsControl" x:Name="DatabaseRoot"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:RoAura.Controls" xmlns:local="clr-namespace:RoAura" xmlns:converters="clr-namespace:RoAura.Converters" LostKeyboardFocus="Settings_LostFocus">
 <UserControl.Resources>
  <Style x:Key="WatchTableRow" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Setter Property="MinHeight" Value="26"/><Setter Property="Height" Value="26"/></Style>
  <Style x:Key="WatchTableHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="6,2"/></Style>
  <Style x:Key="WatchTableCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="5,2"/></Style>

  <converters:ColorStringToBrushConverter x:Key="WatchColorBrush"/>
  <converters:DoubleToThicknessConverter x:Key="WatchPadding"/>
  <Style x:Key="WatchNumber" TargetType="controls:NumericTextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="Width" Value="88"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="6,0"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Margin" Value="0,3,0,3"/>
  </Style>
 </UserControl.Resources>
 <TabControl Margin="8" Style="{StaticResource SectionTabControlStyle}">
  <TabItem Header="{DynamicResource BasicTab}"><Grid Margin="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Padding="16" CornerRadius="8" Background="#E5F0FC" BorderBrush="{StaticResource RoSoftBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource DatabaseTitle}" FontSize="20"/>
                                <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Text="{DynamicResource DatabaseDescription}"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="18" VerticalAlignment="Top">
                            <TextBlock Text="{DynamicResource DatabaseHotkeyTitle}" FontFamily="Georgia" FontWeight="Bold" FontSize="17" Foreground="{StaticResource RoBlueBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <ComboBox Width="100" ItemsSource="{Binding HotkeyChoices}" SelectedItem="{Binding DatabaseHotkey, Mode=TwoWay}"/>
                                <Button Content="{DynamicResource OpenDatabase}" Margin="10,0,0,0" Click="OpenDatabase_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <TextBlock Text="{DynamicResource MarketRefreshInterval}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <controls:NumericTextBox Width="90" Height="30" MinHeight="30" Padding="7,0" VerticalContentAlignment="Center" Value="{Binding MarketBackgroundRefreshMinutes, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="{DynamicResource WatchHistoryRetentionDays}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <controls:NumericTextBox Width="90" Height="30" Padding="7,0" VerticalContentAlignment="Center" Value="{Binding MarketWatchHistoryRetentionDays, Mode=TwoWay}"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource WatchHistoryRetentionHint}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource RoMutedBrush}"/>
                            <TextBlock Margin="0,12,0,0" Foreground="#A34C13" TextWrapping="Wrap" Text="{DynamicResource MarketRefreshWarning}"/>
                            <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" Foreground="{StaticResource RoMutedBrush}" Text="{DynamicResource DatabaseInputHint}"/>
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource RoMutedBrush}" Text="{DynamicResource DatabaseSearchLimitHint}"/>
                        </StackPanel>
                    </Grid></TabItem>
  <TabItem Header="{DynamicResource WatchListTitle}">
   <Grid Margin="14">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="330"/><ColumnDefinition Width="14"/><ColumnDefinition Width="0.85*" MinWidth="340"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0"><Grid.RowDefinitions><RowDefinition Height="0.85*" MinHeight="125"/><RowDefinition Height="Auto"/><RowDefinition Height="1.15*" MinHeight="130"/></Grid.RowDefinitions>
     <DataGrid RowStyle="{StaticResource WatchTableRow}" ColumnHeaderStyle="{StaticResource WatchTableHeader}" CellStyle="{StaticResource WatchTableCell}" x:Name="WatchList" Grid.Row="0" ItemsSource="{Binding MarketWatchRules}" SelectionChanged="WatchList_SelectionChanged"
        AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" RowHeaderWidth="0">
      <DataGrid.Columns>
       <DataGridTextColumn Header="{DynamicResource Name}" Width="*" MinWidth="100" Binding="{Binding Caption}"/>
       <DataGridTextColumn Header="{DynamicResource WatchPriceRule}" Width="155" Binding="{Binding PriceCaption}"/>
       <DataGridTemplateColumn Header="{DynamicResource Enabled}" Width="90">
        <DataGridTemplateColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource WatchTableHeader}"><Setter Property="HorizontalContentAlignment" Value="Center"/></Style></DataGridTemplateColumn.HeaderStyle>
        <DataGridTemplateColumn.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource WatchTableCell}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style></DataGridTemplateColumn.CellStyle>
        <DataGridTemplateColumn.CellTemplate><DataTemplate><Grid HorizontalAlignment="Stretch">
         <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource WatchPauseHint}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="18" Height="18" Margin="0">
          <CheckBox.Template><ControlTemplate TargetType="CheckBox"><Grid Width="18" Height="18">
           <Border x:Name="Box" CornerRadius="4" Background="White" BorderBrush="#789DCF" BorderThickness="1"/>
           <Path x:Name="Tick" Data="M 3 8 L 7 12 L 15 4" Stroke="White" StrokeThickness="2.2" Visibility="Collapsed"/>
          </Grid><ControlTemplate.Triggers>
           <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#477FC9"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
           <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers></ControlTemplate></CheckBox.Template>
         </CheckBox>
        </Grid></DataTemplate></DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
      </DataGrid.Columns>
     </DataGrid>
     <StackPanel Grid.Row="1" Margin="0,10,0,6">
      <TextBlock Text="{DynamicResource WatchHistoryTitle}" FontWeight="SemiBold"/>
      <TextBlock x:Name="HistoryItemText" TextWrapping="Wrap" Foreground="{StaticResource RoMutedBrush}"/>
      <TextBlock x:Name="HistoryPersistenceWarning" Text="{DynamicResource WatchHistorySaveWarning}" TextWrapping="Wrap" Foreground="#B42318" Visibility="Collapsed"/>
     </StackPanel>
     <Grid Grid.Row="2">
      <DataGrid RowStyle="{StaticResource WatchTableRow}" ColumnHeaderStyle="{StaticResource WatchTableHeader}" CellStyle="{StaticResource WatchTableCell}" x:Name="HistoryGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" RowHeaderWidth="0" SelectionMode="Single">
       <DataGrid.Columns>
        <DataGridTextColumn Header="{DynamicResource WatchHistoryTime}" Width="125" Binding="{Binding TimeCaption}"/>
        <DataGridTextColumn Header="{DynamicResource WatchHistoryShop}" Width="*" MinWidth="80" Binding="{Binding ShopCaption}"/>
        <DataGridTextColumn Header="{DynamicResource WatchHistoryCoordinates}" Width="130" Binding="{Binding Coordinates}"/>
        <DataGridTextColumn Header="{DynamicResource WatchHistoryPrice}" Width="105" Binding="{Binding PriceCaption}"/>
       </DataGrid.Columns>
      </DataGrid>
      <TextBlock x:Name="HistoryEmptyText" Text="{DynamicResource WatchHistoryEmpty}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,35,12,8" Foreground="{StaticResource RoMutedBrush}" IsHitTestVisible="False"/>
     </Grid>
    </Grid>
    <Border Grid.Column="2" Background="#F4F8FD" BorderBrush="{StaticResource RoSoftBorderBrush}" BorderThickness="1" Padding="16,12">
     <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><local:MarketWatchEditor x:Name="WatchEditor" Margin="0,0,5,12"/></ScrollViewer>
      <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,10,0,0">
       <Button Content="{DynamicResource Add}" Click="AddWatch_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
       <Button x:Name="EditWatchButton" Content="{DynamicResource WatchEdit}" Click="EditWatch_Click" Margin="0,0,8,0" IsEnabled="False"/>
       <Button x:Name="DeleteWatchButton" Content="{DynamicResource Delete}" Click="DeleteWatch_Click" Style="{StaticResource DangerButtonStyle}" IsEnabled="False"/>
      </WrapPanel>
     </Grid>
    </Border>
    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{DynamicResource WatchListHint}" TextWrapping="Wrap" Margin="0,10,0,0"/>
   </Grid>
  </TabItem>
  <TabItem Header="{DynamicResource NotificationsTab}">
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16" DataContext="{Binding MarketWatchNotifications}">
    <Border Background="#F8FBFF" BorderBrush="{StaticResource RoSoftBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,10">
     <StackPanel><TextBlock Text="{DynamicResource WatchPreviewTitle}" FontWeight="SemiBold" Foreground="{StaticResource RoMutedBrush}" Margin="0,0,0,8"/>
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="160">
       <local:MarketWatchNotificationView HorizontalAlignment="Left" Settings="{Binding}" Notification="{Binding PreviewNotification, ElementName=DatabaseRoot}"/>
      </ScrollViewer>
     </StackPanel>
    </Border>
    <WrapPanel Margin="0,0,0,9" VerticalAlignment="Center">
     <CheckBox Content="{DynamicResource Enabled}" IsChecked="{Binding Enabled}" Margin="0,5,18,5"/>
     <CheckBox Content="{DynamicResource WatchShowIcon}" IsChecked="{Binding ShowIcon}" Margin="0,5,18,5"/>
     <Button Content="{DynamicResource WatchChooseIcon}" Click="ChooseIcon_Click" Margin="0,0,8,0"/>
     <Button Content="{DynamicResource WatchItemIcon}" Click="ResetIcon_Click" Margin="0,0,8,0"/>
     <Button Content="{DynamicResource WatchPreview}" Click="Preview_Click"/>
    </WrapPanel>
    <TextBlock Text="{DynamicResource WatchTemplate}"/>
    <TextBox Height="30" Padding="7,0" VerticalContentAlignment="Center" Text="{Binding TextTemplate, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,3"/>
    <TextBlock Text="{DynamicResource WatchTemplateHint}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,9"/>
    <Grid HorizontalAlignment="Left">
     <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="95"/><ColumnDefinition Width="18"/><ColumnDefinition Width="190"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="{DynamicResource IconSize}" VerticalAlignment="Center" TextWrapping="Wrap"/><controls:NumericTextBox Grid.Column="1" Value="{Binding IconSize, Mode=TwoWay}" Style="{StaticResource WatchNumber}"/>
     <TextBlock Grid.Column="3" Text="{DynamicResource TextSize}" VerticalAlignment="Center" TextWrapping="Wrap"/><controls:NumericTextBox Grid.Column="4" Value="{Binding TextSize, Mode=TwoWay}" Style="{StaticResource WatchNumber}"/>
     <TextBlock Grid.Row="1" Text="{DynamicResource IconPadding}" VerticalAlignment="Center" TextWrapping="Wrap"/><controls:NumericTextBox Grid.Row="1" Grid.Column="1" Value="{Binding Padding, Mode=TwoWay}" Style="{StaticResource WatchNumber}"/>
     <TextBlock Grid.Row="1" Grid.Column="3" Text="{DynamicResource WatchGap}" VerticalAlignment="Center" TextWrapping="Wrap"/><controls:NumericTextBox Grid.Row="1" Grid.Column="4" Value="{Binding Gap, Mode=TwoWay}" Style="{StaticResource WatchNumber}"/>
     <TextBlock Grid.Row="2" Text="{DynamicResource WatchDuration}" VerticalAlignment="Center" TextWrapping="Wrap"/><controls:NumericTextBox Grid.Row="2" Grid.Column="1" Value="{Binding DurationSeconds, Mode=TwoWay}" Style="{StaticResource WatchNumber}"/>
     <TextBlock Grid.Row="3" Text="{DynamicResource WatchBackground}" VerticalAlignment="Center"/>
     <TextBox x:Name="BackgroundEditor" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Width="110" Height="28" Padding="6,0" VerticalContentAlignment="Center" HorizontalAlignment="Left" Text="{Binding Background, UpdateSourceTrigger=LostFocus}" LostFocus="Color_LostFocus" Margin="0,3"/>
     <TextBlock Grid.Row="3" Grid.Column="3" Text="{DynamicResource WatchTextColor}" VerticalAlignment="Center"/>
     <TextBox x:Name="TextColorEditor" Grid.Row="3" Grid.Column="4" Width="145" Height="28" Padding="6,0" VerticalContentAlignment="Center" Text="{Binding TextColor, UpdateSourceTrigger=LostFocus}" LostFocus="Color_LostFocus" Margin="0,3"/>
    </Grid>
    <WrapPanel Margin="0,9,0,0">
     <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,7,0"/><controls:NumericTextBox Value="{Binding X, Mode=TwoWay}" Style="{StaticResource WatchNumber}" Margin="0,0,16,0"/>
     <TextBlock Text="Y" VerticalAlignment="Center" Margin="0,0,7,0"/><controls:NumericTextBox Value="{Binding Y, Mode=TwoWay}" Style="{StaticResource WatchNumber}" Margin="0,0,16,0"/>
     <Button Content="{DynamicResource WatchMoveOverlay}" Click="MoveOverlay_Click"/>
    </WrapPanel>
    <TextBlock Text="{DynamicResource WatchColorHint}" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left" FontSize="11" Margin="0,7,0,10"/>
    <Border BorderBrush="{StaticResource RoSoftBorderBrush}" BorderThickness="1,1,1,1" Background="#F4F8FD" CornerRadius="6" Padding="10">
     <StackPanel>
      <WrapPanel Margin="0,0,0,7"><CheckBox Content="{DynamicResource WatchSound}" IsChecked="{Binding SoundEnabled}" Margin="0,5,18,5"/>
       <Button Content="{DynamicResource WatchChooseSound}" Click="ChooseSound_Click" Height="32" MinHeight="32" VerticalAlignment="Center" Margin="0,0,8,0"/>
       <Button Content="{DynamicResource WatchListen}" Click="ListenSound_Click" Height="32" MinHeight="32" VerticalAlignment="Center" Margin="0"/>
      </WrapPanel>
      <TextBox Height="28" Padding="6,0" VerticalContentAlignment="Center" Text="{Binding SoundPath}" IsReadOnly="True"/>
      <WrapPanel Margin="0,7,0,0"><TextBlock Text="{DynamicResource WatchVolume}" VerticalAlignment="Center" Margin="0,0,12,0"/>
       <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Width="200" Value="{Binding SoundVolumePercent, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0"/>
       <controls:NumericTextBox Width="65" Value="{Binding SoundVolumePercent, Mode=TwoWay}" Style="{StaticResource WatchNumber}"/><TextBlock Text="%" VerticalAlignment="Center" Margin="6,0"/>
      </WrapPanel>
     </StackPanel>
    </Border>
   </StackPanel></ScrollViewer>
  </TabItem>
 </TabControl>
</UserControl>
