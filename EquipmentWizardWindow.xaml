<Window x:Class="RoAura.EquipmentWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:RoAura.Converters"
        Title="{DynamicResource AddEquipmentTracking}" Width="760" Height="570"
        MinWidth="680" MinHeight="520" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" ShowInTaskbar="False" Background="{StaticResource RoWindowBrush}">
    <Window.Resources>
        <converters:Base64ToImageSourceConverter x:Key="Base64Image"/>
        <converters:DoubleToThicknessConverter x:Key="PreviewPadding"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Padding="22,17" Background="White" BorderBrush="{StaticResource RoSoftBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="StepLabel" Text="{DynamicResource EquipmentWizardStep1}" Foreground="{StaticResource RoBlueBrush}" FontWeight="Bold"/>
                <TextBlock Grid.Row="1" x:Name="TitleLabel" Text="{DynamicResource EquipmentWizardTitle}" Style="{StaticResource RoSectionTitleStyle}" FontSize="24" Margin="0,5,0,0"/>
                <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Height="4" CornerRadius="2" Background="{StaticResource RoBlueBrush}"/><Border x:Name="ProgressStepTwo" Grid.Column="2" Height="4" CornerRadius="2" Background="#D8E2F0"/></Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="22,18">
            <Grid x:Name="DetailsStep">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource EquipmentWizardDetailsHint}" Foreground="{StaticResource RoMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,15"/>
                    <TextBlock Text="{DynamicResource Name}" FontWeight="SemiBold"/><TextBox Text="{Binding Draft.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12"/>
                    <TextBlock Text="{DynamicResource EquipmentText}" FontWeight="SemiBold"/><TextBox Text="{Binding Draft.Text, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12"/>
                    <TextBlock Text="{DynamicResource Group}" FontWeight="SemiBold"/><TextBox Text="{Binding Draft.GroupNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12"/>
                    <Button Content="{DynamicResource PickIcon}" Click="PickIcon_Click" HorizontalAlignment="Left"/>
                    <CheckBox Content="{DynamicResource TrackEquipment}" IsChecked="{Binding Draft.Enabled}" Margin="0,14,0,0"/>
                    <TextBlock x:Name="ValidationText" Foreground="#B64B55" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" Padding="14" CornerRadius="8" Background="#1E3150">
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource EquipmentPreview}" Foreground="#C5D4EA" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,12"/><Border Width="96" Height="96" Padding="{Binding Draft.IconPadding, Converter={StaticResource PreviewPadding}}" CornerRadius="8" BorderThickness="1" BorderBrush="{Binding Draft.BorderColor}" Background="{Binding Draft.BackgroundColor}" HorizontalAlignment="Center"><Image Source="{Binding Draft.IconImageBase64, Converter={StaticResource Base64Image}}" Stretch="UniformToFill"/></Border><TextBlock Text="{Binding Draft.Text}" Foreground="{Binding Draft.TextColor}" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" Margin="4,10,4,0"/></StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="LearnStep" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Padding="20" CornerRadius="9" Background="#EAF3FF" BorderBrush="{StaticResource RoSoftBorderBrush}" BorderThickness="1">
                    <StackPanel><TextBlock Text="{DynamicResource EquipmentWizardLearnTitle}" FontSize="18" FontWeight="Bold"/><TextBlock Text="{DynamicResource EquipmentWizardLearnHint}" Foreground="{StaticResource RoMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
                </Border>
                <CheckBox Grid.Row="1" Content="{DynamicResource DetermineAfterCreate}" IsChecked="{Binding LearnAfterCreate}" Margin="4,18,0,0" FontWeight="SemiBold"/>
                <Border Grid.Row="2" Margin="0,18,0,0" Padding="16" CornerRadius="8" Background="#FFF7E3" BorderBrush="#E7CA79" BorderThickness="1" VerticalAlignment="Top"><TextBlock Text="{DynamicResource EquipmentLearningHint}" TextWrapping="Wrap"/></Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Padding="18,12" Background="White" BorderBrush="{StaticResource RoSoftBorderBrush}" BorderThickness="0,1,0,0"><Grid><Button x:Name="BackButton" Content="{DynamicResource Back}" Click="Back_Click" Visibility="Collapsed" HorizontalAlignment="Left"/><Button x:Name="CancelButton" Content="{DynamicResource Cancel}" Click="Cancel_Click" HorizontalAlignment="Left"/><Button x:Name="NextButton" Content="{DynamicResource Continue}" Click="Next_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right"/><Button x:Name="CreateButton" Content="{DynamicResource CreateEquipmentTracking}" Click="Create_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Visibility="Collapsed"/></Grid></Border>
    </Grid>
</Window>
