<Window x:Class="RoAura.DatabaseOverlayWindow" x:Name="Root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="False"
        AllowsTransparency="True" Background="Transparent" Foreground="#17365F" FontFamily="Trebuchet MS"
        Width="360" MinWidth="320" MinHeight="460">
    <Border BorderBrush="#5E86BD" BorderThickness="2" CornerRadius="9" Background="#F6F9FE">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
            <Border Background="#DCEBFA" BorderBrush="#7DA2D1" BorderThickness="0,0,0,2" CornerRadius="7,7,0,0">
                <Grid Margin="12,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock x:Name="OverlayTitle" Text="База SpringRO" FontFamily="Georgia" FontWeight="Bold" FontSize="19" Foreground="#174D92"/>
                        <TextBlock Text="Monsters · Items · Maps · Market" FontSize="10" Foreground="#55739A"/></StackPanel>
                    <Button x:Name="CloseButton" Grid.Column="1" Content="&#x2715;" Width="34" Height="30" MinHeight="0"
                            Margin="0" Padding="0" FontSize="15" Click="Close_Click"
                            ToolTip="Закрыть базу данных"/>
                </Grid>
            </Border>
            <StackPanel Grid.Row="1" Margin="10,9,10,5">
                <WrapPanel>
                    <RadioButton x:Name="MonstersMode" Content="Монстры" Tag="Monsters" IsChecked="True" Checked="Mode_Checked" Margin="0,0,13,0"/>
                    <RadioButton x:Name="ItemsMode" Content="Предметы" Tag="Items" Checked="Mode_Checked" Margin="0,0,13,0"/>
                    <RadioButton x:Name="MapsMode" Content="Карты" Tag="Maps" Checked="Mode_Checked" Margin="0,0,13,0"/>
                    <RadioButton x:Name="MarketMode" Content="Маркет" Tag="Market" Checked="Mode_Checked"/>
                </WrapPanel>
                <StackPanel x:Name="MarketTypePanel" Orientation="Horizontal" Margin="0,9,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="MarketTypeLabel" Text="Тип магазина:" VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <RadioButton x:Name="MarketSellMode" Content="Продажа" IsChecked="True" Checked="MarketType_Checked" Margin="0,0,14,0"/>
                    <RadioButton x:Name="MarketBuyMode" Content="Покупка" Checked="MarketType_Checked"/>
                </StackPanel>
            </StackPanel>
            <Grid Grid.Row="2" Margin="10,5,10,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Height="36" FontSize="13" Padding="10,3"
                         VerticalContentAlignment="Center" TextChanged="Search_TextChanged" KeyDown="Search_KeyDown"/>
                <Button x:Name="SearchButton" Grid.Column="1" Content="Найти" Width="66" Height="36"
                        MinHeight="0" Margin="6,0,0,0" Padding="5,2" Click="Search_Click"/>
            </Grid>
            <Expander x:Name="MonsterAdvancedHost" Grid.Row="3" Margin="10,0,10,7">
                <Expander.Header>
                    <TextBlock x:Name="AdvancedHeaderText" Text="Расширенный поиск" FontWeight="Bold" Padding="3,5"/>
                </Expander.Header>
                <Grid Margin="0,7,0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0"><TextBlock x:Name="RaceLabel" Text="Раса"/><ComboBox x:Name="RaceFilter" Margin="0,3,0,7" SelectionChanged="AdvancedFilter_Changed"/></StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2"><TextBlock x:Name="ElementLabel" Text="Элемент"/><ComboBox x:Name="ElementFilter" Margin="0,3,0,7" SelectionChanged="AdvancedFilter_Changed"/></StackPanel>
                    <StackPanel Grid.Row="1"><TextBlock x:Name="SizeLabel" Text="Размер"/><ComboBox x:Name="SizeFilter" Margin="0,3,0,7" SelectionChanged="AdvancedFilter_Changed"/></StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock x:Name="ElementLevelLabel" Text="Уровень элемента, от"/><TextBox x:Name="ElementLevelMinFilter" Margin="0,3,0,7" TextChanged="AdvancedFilter_Changed"/></StackPanel>
                    <StackPanel Grid.Row="2"><TextBlock x:Name="LevelMinLabel" Text="Уровень, от"/><TextBox x:Name="LevelMinFilter" Margin="0,3,0,7" TextChanged="AdvancedFilter_Changed"/></StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock x:Name="LevelMaxLabel" Text="Уровень, до"/><TextBox x:Name="LevelMaxFilter" Margin="0,3,0,7" TextChanged="AdvancedFilter_Changed"/></StackPanel>
                    <StackPanel Grid.Row="3"><TextBlock x:Name="BaseExpMinLabel" Text="Base EXP, от"/><TextBox x:Name="BaseExpMinFilter" Margin="0,3,0,7" TextChanged="AdvancedFilter_Changed"/></StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="2"><TextBlock x:Name="JobExpMinLabel" Text="Job EXP, от"/><TextBox x:Name="JobExpMinFilter" Margin="0,3,0,7" TextChanged="AdvancedFilter_Changed"/></StackPanel>
                    <StackPanel Grid.Row="4"><TextBlock x:Name="HpMinLabel" Text="HP, от"/><TextBox x:Name="HpMinFilter" Margin="0,3,0,7" TextChanged="AdvancedFilter_Changed"/></StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="2"><TextBlock x:Name="HpMaxLabel" Text="HP, до"/><TextBox x:Name="HpMaxFilter" Margin="0,3,0,7" TextChanged="AdvancedFilter_Changed"/></StackPanel>
                    <CheckBox x:Name="AggressiveFilter" Grid.Row="5" Content="Агрессивный" Margin="0,4,0,5" Checked="AdvancedFilter_Changed" Unchecked="AdvancedFilter_Changed"/>
                    <CheckBox x:Name="BossFilter" Grid.Row="5" Grid.Column="2" Content="Boss" Margin="0,4,0,5" Checked="AdvancedFilter_Changed" Unchecked="AdvancedFilter_Changed"/>
                    <CheckBox x:Name="MvpFilter" Grid.Row="6" Content="MVP" Margin="0,2,0,2" Checked="AdvancedFilter_Changed" Unchecked="AdvancedFilter_Changed"/>
                </Grid>
            </Expander>
            <Border Grid.Row="4" Margin="10,0,10,8" BorderBrush="#A9C0DD" BorderThickness="1" Background="#F8FBFF" CornerRadius="5">
                <ListBox x:Name="ResultsList" BorderThickness="0" Background="Transparent" SelectionChanged="Results_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate><DataTemplate><Grid Margin="4,3"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="{Binding Caption}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Row="1" Text="{Binding Meta}" FontSize="10" Foreground="#637B9B" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <Border Grid.Row="5" Background="#E6F0FB" BorderBrush="#A9C0DD" BorderThickness="0,1,0,0" CornerRadius="0,0,7,7">
                <TextBlock x:Name="FooterText" Margin="9,5" Text="Введите название или ID" FontSize="10" Foreground="#55739A" TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>
    </Border>
</Window>
