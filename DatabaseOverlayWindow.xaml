<Window x:Class="RoAura.DatabaseOverlayWindow" x:Name="Root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RoAura.Controls"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="False"
        AllowsTransparency="True" Background="Transparent" Foreground="{DynamicResource DatabaseInk}" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Width="360" MinWidth="320" MinHeight="460">
    <Window.Resources>
        <ResourceDictionary Source="Themes/DatabasePresentation.xaml"/>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource DatabaseFrame}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource DatabasePanel}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Background="{DynamicResource DatabaseHead}" BorderBrush="{DynamicResource DatabaseLine}" BorderThickness="0,0,0,1" CornerRadius="9,9,0,0">
                <Grid Margin="12,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="OverlayTitle" Text="База SpringRO" Style="{StaticResource DatabasePanelTitle}"/>
                    <Button x:Name="CloseButton" Grid.Column="1" Content="&#x2715;" Width="34" Height="30" MinHeight="0"
                            Margin="0" Padding="0" FontSize="15" Click="Close_Click"
                            ToolTip="Закрыть базу данных"/>
                </Grid>
            </Border>
            <StackPanel Grid.Row="1" Margin="10,9,10,5">
                <TabControl x:Name="SearchModeTabs" Style="{StaticResource SectionTabControlStyle}" ItemContainerStyle="{StaticResource DatabaseTabItem}" SelectionChanged="Mode_SelectionChanged">
                    <TabItem x:Name="MonstersMode" Header="Монстры" Tag="Monsters" IsSelected="True"/>
                    <TabItem x:Name="ItemsMode" Header="Предметы" Tag="Items"/>
                    <TabItem x:Name="MapsMode" Header="Карты" Tag="Maps"/>
                    <TabItem x:Name="MarketMode" Header="Маркет" Tag="Market"/>
                    <TabItem x:Name="BarterMode" Header="Бартер" Tag="Barter" Visibility="Collapsed"/>
                </TabControl>
                <WrapPanel Margin="0,9,0,0">
                    <Button x:Name="FavoriteListsButton" Margin="0" HorizontalAlignment="Left" Click="OpenFavoriteLists_Click"/>
                    <Button x:Name="RecentCardsButton" Margin="6,0,0,0" Click="RecentCards_Click"/>
                </WrapPanel>
                <DockPanel x:Name="CatalogDownloadPanel" Margin="0,8,0,0" Visibility="Collapsed">
                    <Button x:Name="CatalogDownloadButton" DockPanel.Dock="Right" Content="Загрузить данные"
                            Click="OpenCatalogSettings_Click" Margin="8,0,0,0"/>
                    <TextBlock x:Name="CatalogDownloadStatus" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
                <WrapPanel x:Name="MarketTypePanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,9,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="MarketTypeLabel" Text="Тип магазина:" VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <RadioButton x:Name="MarketSellMode" VerticalAlignment="Center" Content="Продажа" IsChecked="True" Checked="MarketType_Checked" Margin="0,0,14,0"/>
                    <RadioButton x:Name="MarketBuyMode" VerticalAlignment="Center" Content="Покупка" Checked="MarketType_Checked"/>
                    <Button x:Name="RagnarokPlusSignInButton" VerticalAlignment="Center" Content="Войти" Margin="12,0,0,0"
                            Visibility="Collapsed" Click="RagnarokPlusSignIn_Click"/>
                </WrapPanel>
            </StackPanel>
            <Grid Grid.Row="2" Margin="10,5,10,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Height="36" FontSize="13" Padding="10,3"
                         VerticalContentAlignment="Center" TextChanged="Search_TextChanged" KeyDown="Search_KeyDown"/>
                <Button x:Name="SearchButton" Grid.Column="1" Content="Найти" Width="66" Height="36"
                        MinHeight="0" Margin="6,0,0,0" Padding="5,2" Click="Search_Click"/>
            </Grid>
            <Expander x:Name="MonsterAdvancedHost" Grid.Row="3" Margin="10,0,10,7">
                <Expander.Header>
                    <TextBlock x:Name="AdvancedHeaderText" Text="Расширенный поиск" FontWeight="Bold" Padding="3,5"/>
                </Expander.Header>
                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="0,7,0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0"><TextBlock x:Name="RaceLabel" Text="Раса"/><ComboBox x:Name="RaceFilter" Margin="0,3,0,7" SelectionChanged="AdvancedFilter_Changed"/></StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2"><TextBlock x:Name="ElementLabel" Text="Элемент"/><ComboBox x:Name="ElementFilter" Margin="0,3,0,7" SelectionChanged="AdvancedFilter_Changed"/></StackPanel>
                    <StackPanel Grid.Row="1"><TextBlock x:Name="SizeLabel" Text="Размер"/><ComboBox x:Name="SizeFilter" Margin="0,3,0,7" SelectionChanged="AdvancedFilter_Changed"/></StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock x:Name="ElementLevelLabel" Text="Уровень элемента, от"/><TextBox x:Name="ElementLevelMinFilter" Margin="0,3,0,7" TextChanged="AdvancedFilter_Changed"/></StackPanel>
                    <StackPanel Grid.Row="2"><TextBlock x:Name="LevelMinLabel" Text="Уровень, от"/><TextBox x:Name="LevelMinFilter" Margin="0,3,0,7" TextChanged="AdvancedFilter_Changed"/></StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock x:Name="LevelMaxLabel" Text="Уровень, до"/><TextBox x:Name="LevelMaxFilter" Margin="0,3,0,7" TextChanged="AdvancedFilter_Changed"/></StackPanel>
                    <StackPanel Grid.Row="3"><TextBlock x:Name="BaseExpMinLabel" Text="Base EXP, от"/><TextBox x:Name="BaseExpMinFilter" Margin="0,3,0,7" TextChanged="AdvancedFilter_Changed"/></StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="2"><TextBlock x:Name="JobExpMinLabel" Text="Job EXP, от"/><TextBox x:Name="JobExpMinFilter" Margin="0,3,0,7" TextChanged="AdvancedFilter_Changed"/></StackPanel>
                    <StackPanel Grid.Row="4"><TextBlock x:Name="HpMinLabel" Text="HP, от"/><TextBox x:Name="HpMinFilter" Margin="0,3,0,7" TextChanged="AdvancedFilter_Changed"/></StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="2"><TextBlock x:Name="HpMaxLabel" Text="HP, до"/><TextBox x:Name="HpMaxFilter" Margin="0,3,0,7" TextChanged="AdvancedFilter_Changed"/></StackPanel>
                    <CheckBox x:Name="AggressiveFilter" Grid.Row="5" Content="Агрессивный" Margin="0,4,0,5" Checked="AdvancedFilter_Changed" Unchecked="AdvancedFilter_Changed"/>
                    <CheckBox x:Name="BossFilter" Grid.Row="5" Grid.Column="2" Content="Boss" Margin="0,4,0,5" Checked="AdvancedFilter_Changed" Unchecked="AdvancedFilter_Changed"/>
                    <CheckBox x:Name="MvpFilter" Grid.Row="6" Content="MVP" Margin="0,2,0,2" Checked="AdvancedFilter_Changed" Unchecked="AdvancedFilter_Changed"/>
                    <StackPanel Grid.Row="7" Grid.ColumnSpan="3">
                        <TextBlock x:Name="DropItemLabel"/>
                        <TextBox x:Name="DropItemFilter" TextChanged="AdvancedFilter_Changed"/>
                    </StackPanel>
                    <Button x:Name="ResetMonsterFiltersButton" Grid.Row="8" Grid.ColumnSpan="3"
                            Click="ResetMonsterFilters_Click" HorizontalAlignment="Left"/>
                </Grid>
                </ScrollViewer>
            </Expander>
            <WrapPanel x:Name="ItemFilters" Grid.Row="3" Margin="10,0,10,7" Visibility="Collapsed">
                <TextBlock x:Name="ItemSlotsLabel" VerticalAlignment="Center"/>
                <TextBox x:Name="ItemSlotsFilter" Width="40" Margin="5,0,8,0" TextChanged="ItemFilters_Changed"/>
                <CheckBox x:Name="NpcPriceSort" VerticalAlignment="Center" Checked="ItemFilters_Changed" Unchecked="ItemFilters_Changed"/>
            </WrapPanel>
            <Grid x:Name="MapLevelFilters" Grid.Row="3" Margin="10,0,10,7" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="MapLevelMinLabel" Text="Уровень монстра, от"/>
                    <TextBox x:Name="MapLevelMinFilter" AutomationProperties.LabeledBy="{Binding ElementName=MapLevelMinLabel}"
                             Margin="0,3,0,0" TextChanged="MapLevelFilter_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="MapLevelMaxLabel" Text="Уровень монстра, до"/>
                    <TextBox x:Name="MapLevelMaxFilter" AutomationProperties.LabeledBy="{Binding ElementName=MapLevelMaxLabel}"
                             Margin="0,3,0,0" TextChanged="MapLevelFilter_Changed"/>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="3">
                <CheckBox x:Name="CompactMarketPrices" Margin="12,0,12,5" Visibility="{Binding Visibility, ElementName=MarketTypePanel}"
                          Checked="CompactMarketPrices_Changed" Unchecked="CompactMarketPrices_Changed"/>
            <Expander x:Name="MarketPriceDepthPanel" Margin="10,0,10,7" Visibility="Collapsed">
                <Expander.Header>
                    <TextBlock x:Name="MarketPriceDepthHeader" TextWrapping="Wrap"/>
                </Expander.Header>
                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="MarketPriceDepthRows" Margin="4,4,4,2"/>
                </ScrollViewer>
            </Expander>
            </StackPanel>
            <Border Grid.Row="4" Margin="8,0,8,4" BorderThickness="0" Background="{DynamicResource DatabasePanel}" CornerRadius="5">
                <ListBox x:Name="ResultsList" ItemContainerStyle="{StaticResource DatabaseResult}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent" SelectionChanged="Results_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" MaxWidth="92"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentControl Tag="{Binding}" Focusable="False" VerticalAlignment="Center"
                                                HorizontalAlignment="Left" Loaded="ResultDecoration_Loaded" DataContextChanged="ResultDecoration_Changed"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Caption}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{DynamicResource DatabaseMuted}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center"
                                           FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Right" Loaded="ResultMetric_Loaded" DataContextChanged="ResultMetric_Changed"/>
                                <controls:MarketWatchStar Grid.Column="3" Item="{Binding Value}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <Border Grid.Row="5" Background="{DynamicResource DatabaseSoft}" BorderBrush="{DynamicResource DatabaseLine}" BorderThickness="0,1,0,0" CornerRadius="0,0,7,7">
                <DockPanel Margin="12,6">
                    <TextBlock x:Name="DatabaseHotkeyHint" DockPanel.Dock="Right" Margin="8,0,0,0" FontSize="11" Foreground="{DynamicResource DatabaseMuted}"/>
                    <TextBlock x:Name="FooterText" Text="Введите название или ID" FontSize="11"
                               Foreground="{DynamicResource DatabaseMuted}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
