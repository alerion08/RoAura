<Window x:Class="RoAura.QuestBrowserWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RoAura"
 Title="ROQuestie" WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" ShowActivated="False" Background="{StaticResource RoWindowBrush}" Width="1120" Height="780">
 <Window.Resources>
  <Style x:Key="QuestTrackerScrollStyle" TargetType="ScrollBar">
   <Setter Property="Width" Value="16"/><Setter Property="Background" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Grid Background="{x:Null}"><Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="NaN">
     <Track.DecreaseRepeatButton><RepeatButton Opacity="0" Command="ScrollBar.PageUpCommand" Focusable="False"/></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb Height="36" MinHeight="36" MaxHeight="36" Width="12" Focusable="False"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#88A9D7" CornerRadius="6"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Opacity="0" Command="ScrollBar.PageDownCommand" Focusable="False"/></Track.IncreaseRepeatButton>
    </Track></Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border BorderBrush="{StaticResource RoSoftBorderBrush}" BorderThickness="2" CornerRadius="7" Padding="6">
  <Grid><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Background="{StaticResource RoTitleBrush}" MouseLeftButtonDown="Title_Down"><DockPanel Margin="10,0">
    <Button Content="×" DockPanel.Dock="Right" Click="Close_Click" Width="32" Style="{StaticResource TitleBarButtonStyle}"/>
    <TextBlock Text="ROQuestie" Style="{StaticResource RoSectionTitleStyle}" VerticalAlignment="Center"/>
   </DockPanel></Border>
   <local:QuestsPage x:Name="Page" Grid.Row="1"/>
  </Grid>
 </Border>
</Window>
