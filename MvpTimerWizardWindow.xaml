<Window x:Class="RoAura.MvpTimerWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AddMvpTimer}" Width="760" Height="620"
        MinWidth="680" MinHeight="560" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" ShowInTaskbar="False" Background="{StaticResource RoWindowBrush}">
    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource RoHeadingFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,5,10,5"/>
        </Style>
        <Style x:Key="FieldEditorStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,14,4"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Padding="22,17" Background="White" BorderBrush="{StaticResource RoSoftBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel><TextBlock Text="{DynamicResource AddMvpTimer}" Foreground="{StaticResource RoBlueBrush}" FontWeight="Bold"/><TextBlock Text="{DynamicResource MvpTimersTitle}" Style="{StaticResource RoSectionTitleStyle}" FontSize="24" Margin="0,5,0,0"/><TextBlock Text="{DynamicResource MvpTimersHint}" Foreground="{StaticResource RoMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="24,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource MvpSearch}" FontWeight="SemiBold"/>
            <ComboBox x:Name="MonsterBox" Grid.Row="0" Margin="0,26,0,16" Height="38"
                      ItemsSource="{Binding MonsterView}" TextSearch.TextPath="DisplayName"
                      IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                      SelectionChanged="MonsterBox_SelectionChanged" Loaded="MonsterBox_Loaded"
                      DropDownClosed="MonsterBox_DropDownClosed"/>
            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="0.92*"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource Name}" Style="{StaticResource FieldLabelStyle}"/><TextBox Grid.Column="1" Text="{Binding Draft.Name, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Style="{StaticResource FieldEditorStyle}"/>
                        <TextBlock Grid.Row="1" Text="MVP ID" Style="{StaticResource FieldLabelStyle}"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Draft.MonsterId, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource FieldEditorStyle}"/>
                        <TextBlock Grid.Row="2" Text="{DynamicResource Minutes}" Style="{StaticResource FieldLabelStyle}"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Draft.DurationMinutes, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FieldEditorStyle}"/>
                    </Grid>
                    <CheckBox Content="{DynamicResource UseExactKillTime}" IsChecked="{Binding UseExactKillTime}" Margin="2,14,0,5"/>
                    <Grid IsEnabled="{Binding UseExactKillTime}"><Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource KillDate}" Style="{StaticResource FieldLabelStyle}"/><DatePicker Grid.Column="1" SelectedDate="{Binding KillDate}" Height="28" Margin="0,4,14,4"/>
                        <TextBlock Grid.Row="1" Text="{DynamicResource KillTime}" Style="{StaticResource FieldLabelStyle}"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding KillTimeText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldEditorStyle}" ToolTip="HH:mm:ss"/>
                    </Grid>
                    <CheckBox Content="{DynamicResource StartTimerAfterCreate}" IsChecked="{Binding StartAfterCreate}" IsEnabled="{Binding CanStartAfterCreate}" Margin="2,14,0,0"/>
                    <TextBlock x:Name="ValidationText" Foreground="#B64B55" TextWrapping="Wrap" Margin="2,12,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" Padding="14" CornerRadius="8" Background="#F8FBFF" BorderBrush="{StaticResource RoSoftBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="58" Height="58" CornerRadius="7" Background="#EAF2FD" Padding="4"><Image Source="{Binding SelectedMonster.ImagePath}" Stretch="Uniform"/></Border>
                            <StackPanel Margin="11,4,0,0"><TextBlock Text="{Binding SelectedMonster.Name}" FontWeight="Bold" FontSize="16"/><TextBlock Foreground="{StaticResource RoMutedBrush}"><Run Text="MVP ID "/><Run Text="{Binding SelectedMonster.Id}"/></TextBlock></StackPanel>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource RespawnHint}" FontWeight="Bold" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding SelectedMonster.Spawns}">
                            <ItemsControl.ItemTemplate><DataTemplate><Border Padding="8" Margin="0,0,0,6" Background="White" CornerRadius="6" BorderBrush="{StaticResource RoSoftBorderBrush}" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Code}" Foreground="{StaticResource RoMutedBrush}" FontSize="11"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Respawn}" Foreground="{StaticResource RoBlueBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{DynamicResource RespawnHintHelp}" Foreground="{StaticResource RoMutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Padding="18,12" Background="White" BorderBrush="{StaticResource RoSoftBorderBrush}" BorderThickness="0,1,0,0"><Grid><Button Content="{DynamicResource Cancel}" Click="Cancel_Click" HorizontalAlignment="Left"/><Button Content="{DynamicResource CreateMvpTimer}" Click="Create_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right"/></Grid></Border>
    </Grid>
</Window>
