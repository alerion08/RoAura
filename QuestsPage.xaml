<UserControl x:Class="RoAura.QuestsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:RoAura" xmlns:controls="clr-namespace:RoAura.Controls">
 <UserControl.Resources>
  <Style x:Key="QuestError" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="#B42318"/><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <local:QuestStateConverter x:Key="QuestState"/>
  <Style x:Key="QuestCard" TargetType="Border"><Setter Property="Background" Value="{StaticResource RoCardBrush}"/><Setter Property="BorderBrush" Value="{StaticResource RoSoftBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,6,8"/></Style>
  <Style x:Key="QuestText" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{StaticResource RoTextBrush}"/><Setter Property="Margin" Value="0,3"/></Style>
  <Style x:Key="QuestNumber" TargetType="controls:NumericTextBox" BasedOn="{StaticResource RoTextBoxStyle}"><Setter Property="Width" Value="80"/><Setter Property="Margin" Value="8,3,14,3"/></Style>
 </UserControl.Resources>
 <Grid x:Name="WorkspaceRoot" Margin="12" Background="{StaticResource RoPanelBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Visibility="Collapsed" Style="{StaticResource SectionHeaderCardStyle}"><StackPanel><TextBlock Text="ROQuestie" Style="{StaticResource RoDisplayTextStyle}" FontSize="22"/><TextBlock Text="{DynamicResource QSubtitle}" TextWrapping="Wrap" Foreground="{StaticResource RoMutedBrush}"/></StackPanel></Border>
  <Border Grid.Row="1" Style="{StaticResource InfoHintStyle}" Margin="0,0,0,8"><StackPanel>

   <WrapPanel Margin="0,6,0,0"><TextBlock Text="{DynamicResource QProfile}" VerticalAlignment="Center"/><ComboBox x:Name="ProfileChoice" DisplayMemberPath="Caption" MinWidth="220" MaxWidth="360" Margin="8,0" SelectionChanged="Profile_Changed"/><Button Content="{DynamicResource QSaveNow}" Click="Save_Click"/></WrapPanel>
   <TextBlock Text="{Binding ScopeCaption}" TextWrapping="Wrap" Margin="0,5,0,0"/>
  </StackPanel></Border>
  <StackPanel Grid.Row="2" Margin="0,0,0,8">
   <TextBlock Text="{Binding CatalogError}" Style="{StaticResource QuestError}"/><TextBlock Text="{Binding Error}" Style="{StaticResource QuestError}"/>
  </StackPanel>
  <TabControl Grid.Row="3" x:Name="QuestTabs" Style="{StaticResource SectionTabControlStyle}">
   <TabItem Header="{DynamicResource QCatalog}">
    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,8"><TextBlock Text="{DynamicResource QSearch}"/><TextBox x:Name="SearchInput" TextChanged="Search_Changed" Margin="0,4"/>
       <ComboBox x:Name="CategoryChoice" DisplayMemberPath="Caption" SelectionChanged="Filter_Changed" Margin="0,3"/>
       <WrapPanel><CheckBox x:Name="UseLevel" Content="{DynamicResource QLevelFilter}" VerticalAlignment="Center" Click="Filter_Click"/><controls:NumericTextBox x:Name="LevelInput" Value="{Binding FilterLevel, RelativeSource={RelativeSource AncestorType=local:QuestsPage}, Mode=TwoWay}" Style="{StaticResource QuestNumber}" LostKeyboardFocus="Level_Changed" KeyUp="Level_KeyUp"/></WrapPanel>
       <TextBlock Text="{DynamicResource QCategoryHint}" TextWrapping="Wrap" Foreground="{StaticResource RoMutedBrush}"/>
      </StackPanel>

      <Button Grid.Row="2" Content="{DynamicResource QOpenWalkthrough}" Click="OpenGuide_Click" Margin="0,8"/>
     </Grid>
      <Grid Grid.Column="2"><ListBox x:Name="CatalogList" SelectionChanged="Guide_Changed" MouseDoubleClick="OpenGuide_DoubleClick" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="4,6"><Button Content="★" DockPanel.Dock="Right" Click="Track_Click" IsEnabled="{Binding CanTrack}" ToolTip="{DynamicResource QTrackToggle}" Width="30" Height="28" MinHeight="28" Padding="0" Margin="8,0,2,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Foreground" Value="#A0A7AF"/><Setter Property="Opacity" Value="0.55"/><Style.Triggers><DataTrigger Binding="{Binding Tracked}" Value="True"><Setter Property="Foreground" Value="#123D78"/><Setter Property="Opacity" Value="1"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{StaticResource RoMutedBrush}"/></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox><TextBlock x:Name="CatalogEmpty" Text="{DynamicResource QNoResults}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18" IsHitTestVisible="False"/></Grid>

    </Grid>
   </TabItem>
   <TabItem Header="{DynamicResource QActiveTab}">
    <Grid Margin="0,8,0,0">
     <Grid><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="ActiveList" ItemsSource="{Binding Active}">
      <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource QuestCard}"><StackPanel>
       <CheckBox Content="{DynamicResource QVisible}" IsEnabled="{Binding Editable}" IsChecked="{Binding Progress.IsVisibleInOverlay, Mode=OneWay}" Click="Visibility_Click"/>
       <TextBlock Text="{Binding Title}" Style="{StaticResource QuestText}" FontWeight="SemiBold"/><TextBlock Text="{Binding Position}"/>
       <TextBlock Text="{Binding Instruction}" Style="{StaticResource QuestText}"/>
       <TextBlock Text="{DynamicResource QReviewStep}" Foreground="#B42318" TextWrapping="Wrap" Visibility="{Binding Progress.NeedsStepReview, Converter={StaticResource BoolVisibility}}"/>
       <TextBlock Text="{DynamicResource QMissing}" Foreground="#B42318" TextWrapping="Wrap" Visibility="{Binding Progress.IsMissingFromCatalog, Converter={StaticResource BoolVisibility}}"/>
       <WrapPanel><Button Content="Prev" Tag="prev" Click="QuestAction_Click" IsEnabled="{Binding CanPrev}"/><Button Content="Next" Tag="next" Click="QuestAction_Click" IsEnabled="{Binding CanNext}"/><Button Content="More" Tag="more" Click="QuestAction_Click"/><Button Content="↑" Tag="up" IsEnabled="{Binding Editable}" Click="QuestAction_Click" ToolTip="{DynamicResource QUp}"/><Button Content="↓" Tag="down" IsEnabled="{Binding Editable}" Click="QuestAction_Click" ToolTip="{DynamicResource QDown}"/></WrapPanel>
       <WrapPanel><Button Content="{DynamicResource QPause}" Tag="pause" IsEnabled="{Binding Editable}" Click="QuestAction_Click"/><Button Content="{DynamicResource QComplete}" Tag="complete" IsEnabled="{Binding Editable}" Click="QuestAction_Click"/><Button Content="{DynamicResource QRemove}" Tag="remove" IsEnabled="{Binding Editable}" Click="QuestAction_Click"/></WrapPanel>
      </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl></ScrollViewer><TextBlock x:Name="ActiveEmpty" Text="{DynamicResource QNoActive}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18" IsHitTestVisible="False"/></Grid>

    </Grid>
   </TabItem>
   <TabItem Header="{DynamicResource QHistory}">
    <Grid Margin="0,8,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding History}">
     <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource QuestCard}"><StackPanel>
      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><WrapPanel><TextBlock Text="{Binding StateCaption}" Margin="0,4,12,4"/><TextBlock Text="{Binding LastMark}" Margin="0,4"/></WrapPanel>
      <TextBlock Text="{DynamicResource QManualHistory}" TextWrapping="Wrap" Foreground="{StaticResource RoMutedBrush}"/>
      <Expander Header="{DynamicResource QHistory}"><ItemsControl ItemsSource="{Binding Progress.History}"><ItemsControl.ItemTemplate><DataTemplate><WrapPanel><TextBlock Text="UTC" Margin="0,3,6,3"/><TextBlock Text="{Binding AtUtc, StringFormat={}{0:g}}" Margin="0,3,12,3"/><TextBlock Text="{Binding State, Converter={StaticResource QuestState}}" Margin="0,3"/></WrapPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
      <WrapPanel><Button Content="{DynamicResource QRestore}" Tag="restore" Click="QuestAction_Click" IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=TabControl}}"/><Button Content="More" Tag="more" Click="QuestAction_Click"/></WrapPanel>
     </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl></ScrollViewer><TextBlock x:Name="HistoryEmpty" Text="{DynamicResource QNoHistory}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18" IsHitTestVisible="False"/></Grid>
   </TabItem>
   <TabItem Header="{DynamicResource QWalkthrough}" x:Name="WalkthroughTab"><local:QuestDetailsControl x:Name="CatalogDetails" Margin="0,8,0,0"/></TabItem>
  </TabControl>
 </Grid>
</UserControl>
