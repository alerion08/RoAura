<Window x:Class="RoAura.MainWindow" x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:RoAura.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource AppTitle}" Width="1420" Height="920" MinWidth="1120" MinHeight="760"
        Icon="Assets/roaura.ico" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource RoWindowBrush}" Foreground="{StaticResource RoTextBrush}">
    <Window.Resources>
        <converters:Base64ToImageSourceConverter x:Key="Base64Image" />
        <Style x:Key="DetailGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
        <Style x:Key="SidebarTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavigationButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource RoTextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource RoHeadingFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="7,4" />
            <Setter Property="Height" Value="48" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="NavBorder" Background="Transparent" BorderBrush="Transparent"
                                    BorderThickness="1" CornerRadius="7" Padding="12,0">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="GoldMarker" Width="4" Height="28" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" CornerRadius="2" Background="{StaticResource RoGoldBrush}"
                                    Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#FFE4EFFC" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#FFD1E2FA" />
                                <Setter TargetName="NavBorder" Property="BorderBrush" Value="#FF6E96CE" />
                                <Setter TargetName="GoldMarker" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="#FF174E9A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="23" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Foreground" Value="{StaticResource RoBlueBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="NavIconStyle" TargetType="Image">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource RoHeadingFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,5,10,5" />
        </Style>
        <Style x:Key="FieldEditorStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,14,4" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#557DB7" BorderThickness="1" Margin="5" CornerRadius="8" Background="{StaticResource RoWindowBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="86" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource RoHeaderBrush}" BorderBrush="{StaticResource RoBorderBrush}" BorderThickness="0,0,0,2"
                    CornerRadius="7,7,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="18,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Source="Assets/roaura-icon.png" Width="58" Height="58" Stretch="Uniform" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="RoAura" Style="{StaticResource RoDisplayTextStyle}" FontSize="31" />
                        <TextBlock Text="{DynamicResource Subtitle}" Style="{StaticResource RoCaptionTextStyle}" FontSize="13" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="{DynamicResource Server}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="ServerProfileBox" Width="112" Margin="0,0,14,0" SelectionChanged="ServerProfile_SelectionChanged">
                            <ComboBoxItem Content="RTM" Tag="RTM"/>
                            <ComboBoxItem Content="SpringRO" Tag="SpringRO"/>
                            <ComboBoxItem Content="Другой" Tag="Other"/>
                        </ComboBox>
                        <TextBlock Text="{DynamicResource Language}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="LanguageBox" Width="120" SelectionChanged="Language_SelectionChanged">
                            <ComboBoxItem Content="Русский" Tag="ru" />
                            <ComboBoxItem Content="English" Tag="en" />
                        </ComboBox>
                    </StackPanel>
                    <Border Grid.Column="3" Padding="12,7" VerticalAlignment="Center" Background="#DFFFFFFF" CornerRadius="5"
                            BorderBrush="{StaticResource RoSoftBorderBrush}" BorderThickness="1">
                        <TextBlock Foreground="{StaticResource RoBlueBrush}">
                            <Run Text="{Binding SettingsHotkey}" /><Run Text=" — "/><Run Text="{DynamicResource SettingsShort}" />
                            <Run Text=" · "/><Run Text="{Binding OverlaysHotkey}" /><Run Text=" — "/><Run Text="{DynamicResource OverlaysShort}" />
                        </TextBlock>
                    </Border>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Top">
                        <Button Content="—" ToolTip="Свернуть" Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeWindow_Click"/>
                        <Button x:Name="MaximizeWindowButton" Content="□" ToolTip="Развернуть" Style="{StaticResource TitleBarButtonStyle}"
                                Click="ToggleMaximizeWindow_Click"/>
                        <Button Content="×" ToolTip="Закрыть" Style="{StaticResource DangerButtonStyle}" Width="36" Height="30"
                                MinHeight="30" Padding="0" FontSize="18" Click="CloseWindow_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="9,8,9,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="215" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#EFFFFFFF" BorderBrush="{StaticResource RoSoftBorderBrush}" BorderThickness="1" CornerRadius="7">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Margin="2,8">
                            <RadioButton x:Name="HomeNavButton" Tag="0" Style="{StaticResource NavigationButtonStyle}" Checked="Navigation_Checked">
                                <StackPanel Orientation="Horizontal"><Image Source="Assets/roaura-icon.png" Style="{StaticResource NavIconStyle}"/><TextBlock Text="{DynamicResource Home}" VerticalAlignment="Center"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="CooldownNavButton" Tag="1" Style="{StaticResource NavigationButtonStyle}" Checked="Navigation_Checked">
                                <StackPanel Orientation="Horizontal"><Image Source="Assets/Menu/01_cooldowns.png" Style="{StaticResource NavIconStyle}"/><TextBlock Text="{DynamicResource Cooldowns}" VerticalAlignment="Center"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="EffectsNavButton" Tag="2" Style="{StaticResource NavigationButtonStyle}" Checked="Navigation_Checked">
                                <StackPanel Orientation="Horizontal"><Image Source="Assets/Menu/02_buffs_debuffs.png" Style="{StaticResource NavIconStyle}"/><TextBlock Text="{DynamicResource Effects}" VerticalAlignment="Center"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RemindersNavButton" Tag="3" Style="{StaticResource NavigationButtonStyle}" Checked="Navigation_Checked">
                                <StackPanel Orientation="Horizontal"><Image Source="Assets/Menu/03_reminder.png" Style="{StaticResource NavIconStyle}"/><TextBlock Text="{DynamicResource Reminders}" VerticalAlignment="Center"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="EquipmentNavButton" Tag="4" Style="{StaticResource NavigationButtonStyle}" Checked="Navigation_Checked">
                                <StackPanel Orientation="Horizontal"><Image Source="Assets/Menu/04_equipment.png" Style="{StaticResource NavIconStyle}"/><TextBlock Text="{DynamicResource Equipment}" VerticalAlignment="Center"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="MvpNavButton" Tag="5" Style="{StaticResource NavigationButtonStyle}" Checked="Navigation_Checked">
                                <StackPanel Orientation="Horizontal"><Image Source="Assets/Menu/05_mvp_timers.png" Style="{StaticResource NavIconStyle}"/><TextBlock Text="{DynamicResource MvpTimers}" VerticalAlignment="Center"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="LootNavButton" Tag="6" Style="{StaticResource NavigationButtonStyle}" Checked="Navigation_Checked">
                                <StackPanel Orientation="Horizontal"><Image Source="Assets/Menu/06_loot_zeny_exp.png" Style="{StaticResource NavIconStyle}"/><TextBlock Text="{DynamicResource LootRewards}" VerticalAlignment="Center"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="GoldGoblinNavButton" Tag="7" Style="{StaticResource NavigationButtonStyle}" Checked="Navigation_Checked">
                                <StackPanel Orientation="Horizontal"><Image Source="Assets/Menu/08_gold_goblin.png" Style="{StaticResource NavIconStyle}"/><TextBlock Text="{DynamicResource GoldGoblin}" VerticalAlignment="Center"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="DatabaseNavButton" Tag="8" Style="{StaticResource NavigationButtonStyle}" Checked="Navigation_Checked">
                                <StackPanel Orientation="Horizontal"><Image Source="Assets/Menu/09_database.png" Style="{StaticResource NavIconStyle}"/><TextBlock Text="{DynamicResource Database}" VerticalAlignment="Center"/></StackPanel>
                            </RadioButton>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="9,0,9,10">
                            <Separator Margin="2,4,2,8" Background="{StaticResource RoSoftBorderBrush}"/>
                            <Button Click="About_Click" HorizontalContentAlignment="Left" Style="{StaticResource GhostButtonStyle}">
                                <StackPanel Orientation="Horizontal"><Image Source="Assets/Menu/07_about.png" Style="{StaticResource NavIconStyle}"/><TextBlock Text="{DynamicResource About}" VerticalAlignment="Center"/></StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Expander x:Name="ConnectionSettingsPanel" Header="{DynamicResource ConnectionAndControl}" IsExpanded="False"
                              Margin="0,0,0,7" Padding="10,6" BorderBrush="{StaticResource RoSoftBorderBrush}"
                              BorderThickness="1" Background="#EFFFFFFF">
                <Expander.Style>
                    <Style TargetType="Expander">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=MainTabs}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Expander.Style>
                <StackPanel>
                    <WrapPanel>
                        <CheckBox x:Name="EnabledBox" Content="{DynamicResource TrackingEnabled}" Margin="0,0,18,0" />
                    </WrapPanel>
                    <WrapPanel Margin="0,10,0,0">
                        <CheckBox Content="{DynamicResource ReadPackets}" IsChecked="{Binding PacketCaptureEnabled}" Margin="0,0,16,0" />
                        <TextBlock Text="{DynamicResource Server}" VerticalAlignment="Center" />
                        <TextBox Width="130" Margin="6,0,10,0" Text="{Binding PacketServerAddress}" />
                        <TextBlock Text="{DynamicResource Port}" VerticalAlignment="Center" />
                        <TextBox Width="66" Margin="6,0,10,0" Text="{Binding PacketServerPort}" />
                        <TextBlock Text="{DynamicResource Process}" VerticalAlignment="Center" />
                        <TextBox x:Name="ProcessesBox" Width="150" Margin="6,0,10,0" />
                        <CheckBox Content="{DynamicResource AutoDetectConnection}" IsChecked="{Binding AutoDetectConnection}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <Button Content="{DynamicResource DetectConnectionNow}" Click="AutoDetectConnection_Click" />
                        <Button Content="{DynamicResource CheckNpcap}" Click="CheckNpcap_Click" />
                        <Button Content="{DynamicResource ResetAid}" Click="ResetPacketAid_Click" />
                    </WrapPanel>
                    <Border Margin="0,8,0,0" Padding="8,5" Background="#FFEAF4FF" BorderBrush="#FFB9CEE3" BorderThickness="1">
                        <TextBlock Text="{Binding PacketCaptureStateText}" Foreground="#FF32618A" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Border>
                    <WrapPanel Margin="0,10,0,0">
                        <TextBlock Text="{DynamicResource Hotkeys}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <TextBlock Text="{DynamicResource SettingsWindowHotkey}" VerticalAlignment="Center" />
                        <ComboBox Width="78" Margin="6,0,14,0" ItemsSource="{Binding HotkeyChoices}" SelectedItem="{Binding SettingsHotkey, Mode=TwoWay}" />
                        <TextBlock Text="{DynamicResource OverlaysHotkey}" VerticalAlignment="Center" />
                        <ComboBox Width="78" Margin="6,0,14,0" ItemsSource="{Binding HotkeyChoices}" SelectedItem="{Binding OverlaysHotkey, Mode=TwoWay}" />
                        <TextBlock Text="{DynamicResource FinishMoveHotkey}" VerticalAlignment="Center" />
                        <ComboBox Width="88" Margin="6,0,14,0" ItemsSource="{Binding HotkeyChoices}" SelectedItem="{Binding FinishMoveHotkey, Mode=TwoWay}" />
                        <TextBlock Text="{DynamicResource TimersHotkey}" VerticalAlignment="Center" />
                        <ComboBox Width="78" Margin="6,0,14,0" ItemsSource="{Binding HotkeyChoices}" SelectedItem="{Binding TimersHotkey, Mode=TwoWay}" />
                        <StackPanel x:Name="DatabaseHotkeyControls" Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource DatabaseHotkey}" VerticalAlignment="Center" />
                            <ComboBox Width="78" Margin="6,0,14,0" ItemsSource="{Binding HotkeyChoices}" SelectedItem="{Binding DatabaseHotkey, Mode=TwoWay}" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource HotkeyExamples}" Foreground="{StaticResource RoMutedBrush}" VerticalAlignment="Center" />
                    </WrapPanel>
                </StackPanel>
                    </Expander>

                    <TabControl x:Name="MainTabs" Grid.Row="1" Style="{StaticResource SidebarTabControlStyle}" Background="Transparent">
                <TabItem Header="{DynamicResource Home}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="8,4,12,12">
                            <Border Padding="22,18" CornerRadius="10" Background="{StaticResource RoHeaderBrush}"
                                    BorderBrush="{StaticResource RoBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource HomeTitle}" Style="{StaticResource RoDisplayTextStyle}" FontSize="27"/>
                                        <TextBlock Text="{DynamicResource HomeSubtitle}" Style="{StaticResource RoCaptionTextStyle}"
                                                   FontSize="14" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Padding="13,8" CornerRadius="16" Background="#E8FFFFFF"
                                            BorderBrush="{StaticResource RoSoftBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="10" Height="10" Fill="#FF45A66B" Margin="0,0,8,0"/>
                                            <TextBlock Text="{DynamicResource ReadyToWork}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <UniformGrid Columns="4" Margin="0,12,0,0">
                                <Border Style="{StaticResource DashboardCardStyle}">
                                    <StackPanel><TextBlock Text="{Binding Skills.Count}" Style="{StaticResource DashboardValueStyle}"/><TextBlock Text="{DynamicResource Cooldowns}" Style="{StaticResource DashboardLabelStyle}"/></StackPanel>
                                </Border>
                                <Border Style="{StaticResource DashboardCardStyle}">
                                    <StackPanel><TextBlock Text="{Binding Effects.Count}" Style="{StaticResource DashboardValueStyle}"/><TextBlock Text="{DynamicResource Effects}" Style="{StaticResource DashboardLabelStyle}"/></StackPanel>
                                </Border>
                                <Border Style="{StaticResource DashboardCardStyle}">
                                    <StackPanel><TextBlock Text="{Binding Reminders.Count}" Style="{StaticResource DashboardValueStyle}"/><TextBlock Text="{DynamicResource Reminders}" Style="{StaticResource DashboardLabelStyle}"/></StackPanel>
                                </Border>
                                <Border Style="{StaticResource DashboardCardStyle}">
                                    <StackPanel><TextBlock Text="{Binding Equipment.Count}" Style="{StaticResource DashboardValueStyle}"/><TextBlock Text="{DynamicResource Equipment}" Style="{StaticResource DashboardLabelStyle}"/></StackPanel>
                                </Border>
                            </UniformGrid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                <GroupBox Header="{DynamicResource QuickStart}" Style="{StaticResource DetailGroupBoxStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource QuickStartHint}" TextWrapping="Wrap" Foreground="{StaticResource RoMutedBrush}" Margin="0,0,0,10"/>
                                        <Button Content="{DynamicResource ConfigureCooldowns}" Tag="1" Click="QuickNavigate_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch"/>
                                        <Button Content="{DynamicResource ConfigureEffects}" Tag="2" Click="QuickNavigate_Click" HorizontalAlignment="Stretch"/>
                                        <Button Content="{DynamicResource ConfigureReminders}" Tag="3" Click="QuickNavigate_Click" HorizontalAlignment="Stretch"/>
                                        <Button Content="{DynamicResource ConfigureEquipment}" Tag="4" Click="QuickNavigate_Click" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Grid.Column="1" Header="{DynamicResource ConnectionStatus}" Style="{StaticResource DetailGroupBoxStyle}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding PacketCaptureStateText}" TextWrapping="Wrap" Foreground="{StaticResource RoBlueBrush}" FontWeight="SemiBold"/>
                                        <Separator/>
                                        <TextBlock Text="{DynamicResource ConnectionStatusHint}" TextWrapping="Wrap" Foreground="{StaticResource RoMutedBrush}"/>
                                        <Button Content="{DynamicResource DetectConnectionNow}" Click="AutoDetectConnection_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </GroupBox>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{DynamicResource Cooldowns}">
                    <Grid Margin="8,4,8,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="240" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="0" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,8" Padding="14,9" CornerRadius="7"
                                Background="#E5F0FC" BorderBrush="{StaticResource RoSoftBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource RoPrimaryButtonBrush}" Margin="0,0,10,0">
                                    <TextBlock Text="◷" Foreground="White" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{DynamicResource CooldownSettingsTitle}" Style="{StaticResource RoSectionTitleStyle}"/>
                                    <TextBlock Text="{DynamicResource CooldownSettingsHint}" Style="{StaticResource RoCaptionTextStyle}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="{DynamicResource AddSkill}" Click="Add_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Grid.RowSpan="2" Style="{StaticResource WorkspacePanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel>
                                    <Grid Margin="2,0,2,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource MySkills}" FontWeight="Bold" FontSize="15"/><TextBlock Foreground="{StaticResource RoMutedBrush}" FontSize="11"><Run Text="{Binding Skills.Count, Mode=OneWay}"/><Run Text=" "/><Run Text="{DynamicResource SkillsConfigured}"/></TextBlock></StackPanel><Button Grid.Column="1" Content="{DynamicResource Add}" Click="Add_Click" Style="{StaticResource PrimaryButtonStyle}"/></Grid>
                                    <TextBox x:Name="SkillSearchBox" TextChanged="SkillSearch_TextChanged" ToolTip="{DynamicResource SkillSearchHint}" Margin="0,0,0,9"/>
                                </StackPanel>
                                <ListBox Grid.Row="1" x:Name="SkillsGrid" ItemsSource="{Binding Skills}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="BorderThickness" Value="0"/></Style></ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate><DataTemplate><Border Padding="10" CornerRadius="8" BorderThickness="1"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#F8FBFF"/><Setter Property="BorderBrush" Value="{StaticResource RoSoftBorderBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Background" Value="{StaticResource RoSelectionBrush}"/><Setter Property="BorderBrush" Value="{StaticResource RoBlueBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="7" Background="#EDF3FB" Padding="3"><Image Source="{Binding IconImageBase64, Converter={StaticResource Base64Image}}" Stretch="Uniform"/></Border><StackPanel Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"/><TextBlock Foreground="{StaticResource RoMutedBrush}" FontSize="11"><Run Text="Skill ID: "/><Run Text="{Binding PacketSkillId}"/><Run Text=" · "/><Run Text="{Binding CooldownSeconds}"/><Run Text=" sec · "/><Run Text="{DynamicResource Group}"/><Run Text=" "/><Run Text="{Binding GroupNumber}"/></TextBlock></StackPanel><CheckBox Grid.Column="2" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22" CornerRadius="8" Background="#F8FBFF"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=SkillsGrid}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="{DynamicResource NoSkillsTitle}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/><TextBlock Text="{DynamicResource NoSkillsHint}" Foreground="{StaticResource RoMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="245" Margin="0,5,0,10"/><Button Content="{DynamicResource AddSkill}" Click="Add_Click" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel></Border>
                                <TextBlock Grid.Row="2" Text="{DynamicResource SkillListHint}" Foreground="{StaticResource RoMutedBrush}" TextWrapping="Wrap" Margin="2,8,2,0"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="3" Grid.Column="0" Margin="0,8,0,0" Padding="7" CornerRadius="7" Background="#F8FBFF"
                                BorderBrush="{StaticResource RoSoftBorderBrush}" BorderThickness="1">
                            <WrapPanel>
                                <CheckBox Content="{DynamicResource ShortNames}" IsChecked="{Binding ShowShortNames}" Margin="16,0,18,0" VerticalAlignment="Center" />
                                <CheckBox Content="{DynamicResource ReadyText}" IsChecked="{Binding ShowReadyText}" VerticalAlignment="Center" />
                            </WrapPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1" Grid.RowSpan="3" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid DataContext="{Binding SelectedItem, ElementName=SkillsGrid}" MinWidth="680">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.05*" />
                                    <ColumnDefinition Width="1.15*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.ColumnSpan="2" Margin="8,4,8,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" Style="{StaticResource RoSectionTitleStyle}"/><TextBlock Foreground="{StaticResource RoMutedBrush}"><Run Text="Skill ID: "/><Run Text="{Binding PacketSkillId}"/></TextBlock></StackPanel><Button Grid.Column="1" Content="{DynamicResource TestCooldown}" Click="Test_Click"/></Grid>
                                <GroupBox Grid.Row="1" Header="{DynamicResource MainParameters}" Style="{StaticResource DetailGroupBoxStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
