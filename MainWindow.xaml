                                        <TextBlock Grid.Row="2" Text="{DynamicResource TextColor}" Style="{StaticResource FieldLabelStyle}"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TimersTextColor}" Style="{StaticResource FieldEditorStyle}"/>
                                        <TextBlock Grid.Row="3" Text="{DynamicResource TimerGap}" Style="{StaticResource FieldLabelStyle}"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding TimersGap}" Style="{StaticResource FieldEditorStyle}"/>
                                        <TextBlock Grid.Row="4" Text="{DynamicResource TimersHotkey}" Style="{StaticResource FieldLabelStyle}"/><ComboBox Grid.Row="4" Grid.Column="1" Width="90" HorizontalAlignment="Left" ItemsSource="{Binding HotkeyChoices}" SelectedItem="{Binding TimersHotkey}"/>
                                    </Grid>
                                </GroupBox>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem x:Name="LootTab" Header="{DynamicResource LootRewards}">
                    <Grid Margin="8">
                        <Grid.RowDefinitions><RowDefinition Height="210" MinHeight="90"/><RowDefinition Height="6"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DataGrid x:Name="RewardChannelsGrid" ItemsSource="{Binding RewardChannels}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="{DynamicResource On}" Binding="{Binding Enabled}" Width="55"/>
                                <DataGridTextColumn Header="{DynamicResource RewardType}" Binding="{Binding DisplayName, Mode=OneWay}" IsReadOnly="True" Width="2*"/>
                                <DataGridTextColumn Header="{DynamicResource Group}" Binding="{Binding GroupNumber}" Width="100"/>
                                <DataGridTextColumn Header="{DynamicResource DisplayOrder}" Binding="{Binding Order}" Width="140"/>
                                <DataGridTextColumn Header="{DynamicResource TextColor}" Binding="{Binding TextColor}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#9DB7D8" Cursor="SizeNS"/>
                        <WrapPanel Grid.Row="2" Margin="0,7,0,9">
                            <Button Content="{DynamicResource TestNotifications}" Click="TestRewards_Click"/>
                            <ToggleButton x:Name="RewardMoveModeButton" Content="{DynamicResource MoveRewardGroup}"
                                          Checked="RewardMoveMode_Changed" Unchecked="RewardMoveMode_Changed"/>
                        </WrapPanel>
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <GroupBox Header="{DynamicResource RewardChannel}" Style="{StaticResource DetailGroupBoxStyle}"
                                          DataContext="{Binding SelectedItem, ElementName=RewardChannelsGrid}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="175"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <TextBlock Text="{DynamicResource RewardType}" Style="{StaticResource FieldLabelStyle}"/><TextBox Grid.Column="1" Text="{Binding DisplayName, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource FieldEditorStyle}"/>
                                        <TextBlock Grid.Row="1" Text="{DynamicResource Enabled}" Style="{StaticResource FieldLabelStyle}"/><CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="2" Text="{DynamicResource Group}" Style="{StaticResource FieldLabelStyle}"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding GroupNumber}" Style="{StaticResource FieldEditorStyle}"/>
                                        <TextBlock Grid.Row="3" Text="{DynamicResource DisplayOrder}" Style="{StaticResource FieldLabelStyle}"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Order}" Style="{StaticResource FieldEditorStyle}"/>
                                        <TextBlock Grid.Row="4" Text="{DynamicResource TextColor}" Style="{StaticResource FieldLabelStyle}"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding TextColor}" Style="{StaticResource FieldEditorStyle}"/>
                                    </Grid>
                                </GroupBox>
                                <GroupBox Grid.Column="1" Header="{DynamicResource RewardGroupSettings}" Style="{StaticResource DetailGroupBoxStyle}"
                                          DataContext="{Binding SelectedItem, ElementName=RewardGroupBox}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <TextBlock Text="{DynamicResource RewardGroup}" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="RewardGroupBox" Grid.Column="1" ItemsSource="{Binding DataContext.RewardGroups, ElementName=RootWindow}" DisplayMemberPath="GroupNumber" Height="28" Margin="0,4,14,4"/>
                                        <TextBlock Grid.Row="1" Text="{DynamicResource PositionXY}" Style="{StaticResource FieldLabelStyle}"/><StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"><TextBox Width="85" Text="{Binding X}" Style="{StaticResource FieldEditorStyle}"/><TextBox Width="85" Text="{Binding Y}" Style="{StaticResource FieldEditorStyle}"/></StackPanel>
                                        <TextBlock Grid.Row="2" Text="{DynamicResource TextSize}" Style="{StaticResource FieldLabelStyle}"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TextSize}" Style="{StaticResource FieldEditorStyle}"/>
                                        <TextBlock Grid.Row="3" Text="{DynamicResource NotificationDuration}" Style="{StaticResource FieldLabelStyle}"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DurationSeconds}" Style="{StaticResource FieldEditorStyle}"/>
                                        <TextBlock Grid.Row="4" Text="{DynamicResource AggregationWindow}" Style="{StaticResource FieldLabelStyle}"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding AggregationWindowMs}" Style="{StaticResource FieldEditorStyle}"/>
                                        <TextBlock Grid.Row="5" Text="{DynamicResource MaximumLines}" Style="{StaticResource FieldLabelStyle}"/><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding MaxLines}" Style="{StaticResource FieldEditorStyle}"/>
                                        <TextBlock Grid.Row="6" Text="{DynamicResource LineGap}" Style="{StaticResource FieldLabelStyle}"/><TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Gap}" Style="{StaticResource FieldEditorStyle}"/>
                                        <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Text="{DynamicResource RewardGroupingHint}" TextWrapping="Wrap" Foreground="{StaticResource RoMutedBrush}" Margin="4,8,14,0"/>
                                    </Grid>
                                </GroupBox>
                                <GroupBox Grid.Column="2" Header="{DynamicResource GeneralSettings}" Style="{StaticResource DetailGroupBoxStyle}" DataContext="{Binding DataContext, ElementName=RootWindow}">
                                    <StackPanel>
                                        <CheckBox Content="{DynamicResource EnableRewardNotifications}" IsChecked="{Binding RewardsEnabled}" Margin="4,6"/>
                                        <CheckBox Content="{DynamicResource ShowJobExperience}" IsChecked="{Binding ShowJobExperience}" Margin="4,6"/>
                                        <TextBlock Text="{DynamicResource RewardLimitHint}" TextWrapping="Wrap" Foreground="{StaticResource RoMutedBrush}" Margin="4,12,8,4"/>
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox x:Name="LootColorsGroup" Grid.Row="1" Header="{DynamicResource LootTypeColors}" Style="{StaticResource DetailGroupBoxStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <TextBlock Text="Equip" Style="{StaticResource FieldLabelStyle}"/><TextBox Grid.Column="1" Text="{Binding EquipColor}" Style="{StaticResource FieldEditorStyle}"/>
                                        <TextBlock Grid.Row="1" Text="Card" Style="{StaticResource FieldLabelStyle}"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CardColor}" Style="{StaticResource FieldEditorStyle}"/>
                                        <TextBlock Grid.Row="2" Text="Loot" Style="{StaticResource FieldLabelStyle}"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LootColor}" Style="{StaticResource FieldEditorStyle}"/>
                                        <TextBlock Grid.Row="3" Text="Consumables" Style="{StaticResource FieldLabelStyle}"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ConsumableColor}" Style="{StaticResource FieldEditorStyle}"/>
                                    </Grid>
                                </GroupBox>
                                <GroupBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Header="{DynamicResource RateIndicators}" Style="{StaticResource DetailGroupBoxStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="115" MinHeight="70"/><RowDefinition Height="6"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <DataGrid x:Name="RateIndicatorsGrid" ItemsSource="{Binding DataContext.RateIndicators, ElementName=RootWindow}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single">
                                            <DataGrid.Columns>
                                                <DataGridCheckBoxColumn Header="{DynamicResource On}" Binding="{Binding Enabled}" Width="55"/>
                                                <DataGridTextColumn Header="{DynamicResource Indicator}" Binding="{Binding DisplayName, Mode=OneWay}" IsReadOnly="True" Width="2*"/>
                                                <DataGridTextColumn Header="{DynamicResource Group}" Binding="{Binding GroupNumber}" Width="75"/>
                                                <DataGridTextColumn Header="X" Binding="{Binding X}" Width="75"/>
                                                <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="75"/>
                                                <DataGridTextColumn Header="{DynamicResource TextSize}" Binding="{Binding TextSize}" Width="120"/>
                                                <DataGridTextColumn Header="{DynamicResource Opacity}" Binding="{Binding OpacityPercent}" Width="105"/>
                                                <DataGridTextColumn Header="{DynamicResource TextColor}" Binding="{Binding TextColor}" Width="2*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#9DB7D8" Cursor="SizeNS"/>
                                        <WrapPanel Grid.Row="2" Margin="0,7,0,5">
                                            <ToggleButton x:Name="RateIndicatorMoveModeButton" Content="{DynamicResource MoveIndicator}"
                                                          Checked="RateIndicatorMoveMode_Changed" Unchecked="RateIndicatorMoveMode_Changed"/>
                                            <ToggleButton x:Name="RateIndicatorGroupMoveModeButton" Content="{DynamicResource MoveIndicatorGroup}"
                                                          Checked="RateIndicatorGroupMoveMode_Changed" Unchecked="RateIndicatorGroupMoveMode_Changed"/>
                                            <TextBlock Text="{DynamicResource StatisticsRefreshInterval}" VerticalAlignment="Center" Margin="18,0,6,0"/>
                                            <TextBox Width="70" Text="{Binding DataContext.RateStatisticsRefreshSeconds, ElementName=RootWindow}" Style="{StaticResource FieldEditorStyle}"/>
                                            <Button Content="{DynamicResource ResetStatisticsSession}" Click="ResetStatisticsSession_Click" Margin="12,4,4,4"/>
                                        </WrapPanel>
                                        <Grid Grid.Row="3" DataContext="{Binding SelectedItem, ElementName=RateIndicatorsGrid}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Text="{DynamicResource Indicator}" Style="{StaticResource FieldLabelStyle}"/><TextBox Grid.Column="1" Text="{Binding DisplayName, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource FieldEditorStyle}"/>
                                            <TextBlock Grid.Column="2" Text="{DynamicResource Enabled}" Style="{StaticResource FieldLabelStyle}"/><CheckBox Grid.Column="3" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Text="{DynamicResource PositionXY}" Style="{StaticResource FieldLabelStyle}"/><StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"><TextBox Width="80" Text="{Binding X}" Style="{StaticResource FieldEditorStyle}"/><TextBox Width="80" Text="{Binding Y}" Style="{StaticResource FieldEditorStyle}"/></StackPanel>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{DynamicResource TextSize}" Style="{StaticResource FieldLabelStyle}"/><TextBox Grid.Row="1" Grid.Column="3" Text="{Binding TextSize}" Style="{StaticResource FieldEditorStyle}"/>
                                            <TextBlock Grid.Row="2" Text="{DynamicResource TextColor}" Style="{StaticResource FieldLabelStyle}"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TextColor}" Style="{StaticResource FieldEditorStyle}"/>
                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{DynamicResource Opacity}" Style="{StaticResource FieldLabelStyle}"/><TextBox Grid.Row="2" Grid.Column="3" Text="{Binding OpacityPercent}" Style="{StaticResource FieldEditorStyle}"/>
                                            <TextBlock Grid.Row="3" Text="{DynamicResource Group}" Style="{StaticResource FieldLabelStyle}"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding GroupNumber}" Style="{StaticResource FieldEditorStyle}"/>
                                        </Grid>
                                    </Grid>
                                </GroupBox>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <TabItem x:Name="DatabaseTab" Header="{DynamicResource Database}">
                    <Grid Margin="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Padding="16" CornerRadius="8" Background="#E5F0FC" BorderBrush="{StaticResource RoSoftBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource DatabaseTitle}" Style="{StaticResource RoSectionTitleStyle}" FontSize="20"/>
                                <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Text="{DynamicResource DatabaseDescription}"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="18" VerticalAlignment="Top">
                            <TextBlock Text="Горячая клавиша" FontFamily="Georgia" FontWeight="Bold" FontSize="17" Foreground="{StaticResource RoBlueBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <ComboBox Width="100" ItemsSource="{Binding HotkeyChoices}" SelectedItem="{Binding DatabaseHotkey, Mode=TwoWay}"/>
                                <Button Content="{DynamicResource OpenDatabase}" Margin="10,0,0,0" Click="OpenDatabase_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <TextBlock Text="{DynamicResource MarketRefreshInterval}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Width="80" Text="{Binding MarketBackgroundRefreshMinutes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldEditorStyle}"/>
                            </StackPanel>
                            <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" Foreground="{StaticResource RoMutedBrush}" Text="{DynamicResource DatabaseInputHint}"/>
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource RoMutedBrush}" Text="Для быстрого поиска поддерживаются названия и числовые ID. В одной выборке показывается до 100 результатов."/>
                        </StackPanel>
                    </Grid>
                </TabItem>
                    </TabControl>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Margin="10,0,10,6" Padding="9,7" Background="#FFF4F8FC"
                    BorderBrush="{StaticResource RoSoftBorderBrush}" BorderThickness="1" MinHeight="36">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource ActionLog}" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Grid.Column="1" Foreground="{StaticResource RoBlueBrush}"
                               Text="RoAura" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Grid.Row="3" Margin="10,0,10,6" Padding="8,5" Background="#FFF4F8FC"
                    BorderBrush="{StaticResource RoSoftBorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{DynamicResource Preset}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="PresetBox" Width="180" IsEditable="False" Margin="0,0,6,0"/>
                    <Button Content="{DynamicResource ApplyPreset}" Click="ApplyPreset_Click"/>
                    <Button Content="{DynamicResource UpdatePreset}" Click="UpdatePreset_Click"/>
                    <Button Content="{DynamicResource DeletePreset}" Click="DeletePreset_Click" Style="{StaticResource DangerButtonStyle}"/>
                    <TextBlock Text="{DynamicResource NewPresetName}" VerticalAlignment="Center" Margin="18,0,6,0"/>
                    <TextBox x:Name="NewPresetNameBox" Width="170" Margin="0,0,6,0"/>
                    <Button Content="{DynamicResource CreatePreset}" Click="CreatePreset_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="4" Margin="10,0,10,7">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Tag="https://twitch.tv/im_alerion" Click="SocialLink_Click">
                        <StackPanel Orientation="Horizontal"><Image Source="Assets/twitch.png" Width="18" Height="18"/><TextBlock Text=" twitch.tv/im_alerion"/></StackPanel>
                    </Button>
                    <Button Tag="http://discord.gg/aleriontv" Click="SocialLink_Click">
                        <StackPanel Orientation="Horizontal"><Image Source="Assets/discord.png" Width="18" Height="18"/><TextBlock Text=" Discord"/></StackPanel>
                    </Button>
                    <Button Tag="https://www.donationalerts.com/r/im_alerion" Click="SocialLink_Click">
                        <StackPanel Orientation="Horizontal"><Image Source="Assets/donate.png" Width="18" Height="18"/><TextBlock Text=" Donate"/></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{DynamicResource Save}" Click="Save_Click" Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Click="Hide_Click"><TextBlock><Run Text="{DynamicResource Hide}"/><Run Text=" ("/><Run Text="{Binding SettingsHotkey}"/><Run Text=")"/></TextBlock></Button>
                    <Button Content="{DynamicResource Exit}" Click="Exit_Click" Style="{StaticResource DangerButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
