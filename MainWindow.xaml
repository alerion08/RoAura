                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <StackPanel Margin="0,0,0,12"><TextBlock Text="{DynamicResource PriceRulesTitle}" Style="{StaticResource RoSectionTitleStyle}"/><TextBlock Text="{DynamicResource PriceRulesHint}" Style="{StaticResource RoCaptionTextStyle}" Margin="0,2,0,0"/></StackPanel>
                                    <Grid Grid.Row="1" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource SelectItemFromList}" Foreground="{StaticResource RoMutedBrush}" VerticalAlignment="Center" Margin="9,0,12,0"/>
                                        <Button Grid.Column="1" Margin="0,0,8,0" Content="{DynamicResource AddItem}" Click="AddGoldGoblinRule_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                                        <Button Grid.Column="2" Content="{DynamicResource Delete}" Click="DeleteGoldGoblinRule_Click" Style="{StaticResource DangerButtonStyle}"/>
                                    </Grid>
                                    <DataGrid x:Name="GoldGoblinRulesGrid" Grid.Row="2" ItemsSource="{Binding GoldGoblinPriceRules}" AutoGenerateColumns="False" CanUserAddRows="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Item ID" Binding="{Binding ItemId}" IsReadOnly="True" Width="100"/>
                                            <DataGridTextColumn Header="{DynamicResource Name}" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                                            <DataGridCheckBoxColumn Header="{DynamicResource VendingPrice}" Binding="{Binding UseVendingPrice, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                                            <DataGridTextColumn Header="{DynamicResource ManualPrice}" Binding="{Binding ManualPrice, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid></Border>
                            </TabItem>
                            <TabItem Header="{DynamicResource GoldGoblinCalculationTab}">
                                <Border Margin="0,8,0,0" BorderBrush="{StaticResource RoSoftBorderBrush}" BorderThickness="1" CornerRadius="8" Background="White" Padding="20">
