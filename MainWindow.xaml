                                                <TextBlock Text="{DynamicResource GoldGoblinPriceEditHint}" TextWrapping="Wrap" Foreground="{StaticResource RoMutedBrush}" Margin="0,9,0,0"/>
                                            </StackPanel>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>
                                    <Grid Grid.Row="2" Grid.ColumnSpan="3" Background="#F8FAFD" Margin="12,9">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource GoldGoblinTableHint}" Foreground="{StaticResource RoMutedBrush}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="{DynamicResource AddItem}" Click="AddGoldGoblinLoot_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                                    </Grid>
                                </Grid></Border>
                            </TabItem>
                            <TabItem Header="{DynamicResource GoldGoblinRulesTab}">
                                <Border Margin="0,8,0,0" BorderBrush="{StaticResource RoSoftBorderBrush}" BorderThickness="1" CornerRadius="8" Background="White">
