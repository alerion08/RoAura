                                                                    <Setter TargetName="PriceBadgeText" Property="Text" Value="{DynamicResource PriceVendingBadge}"/>
                                                                    <Setter TargetName="PriceBadgeText" Property="Foreground" Value="#6D35B4"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding PriceSource}" Value="Manual">
                                                                    <Setter TargetName="PriceBadge" Property="Background" Value="#E5F0FF"/>
                                                                    <Setter TargetName="PriceBadgeText" Property="Text" Value="{DynamicResource PriceManualBadge}"/>
                                                                    <Setter TargetName="PriceBadgeText" Property="Foreground" Value="#2269B8"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding PriceKnown}" Value="False">
                                                                    <Setter TargetName="PriceBadge" Property="Background" Value="#FFF0D5"/>
                                                                    <Setter TargetName="PriceBadgeText" Property="Text" Value="{DynamicResource PriceUnknownBadge}"/>
                                                                    <Setter TargetName="PriceBadgeText" Property="Foreground" Value="#9A6200"/>
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="{DynamicResource Total}" IsReadOnly="True" Width="140">
