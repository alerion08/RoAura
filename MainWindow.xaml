                                                </ComboBox>
                                            </Grid>
                                        <DataGrid Grid.Row="1" x:Name="GoldGoblinLootGrid" ItemsSource="{Binding GoldGoblinRowsView, ElementName=RootWindow}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" BorderThickness="0" SelectionChanged="GoldGoblinLootGrid_SelectionChanged">
