<Window x:Class="RoAura.MainWindow" x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:RoAura.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource AppTitle}" Width="1420" Height="920" MinWidth="1120" MinHeight="760"
        Icon="Assets/roaura.ico" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource RoWindowBrush}" Foreground="{StaticResource RoTextBrush}">
    <Window.Resources>
        <converters:Base64ToImageSourceConverter x:Key="Base64Image" />
        <Style x:Key="DetailGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
        <Style x:Key="SidebarTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavigationButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource RoTextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource RoHeadingFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="7,4" />
            <Setter Property="Height" Value="48" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="NavBorder" Background="Transparent" BorderBrush="Transparent"
                                    BorderThickness="1" CornerRadius="7" Padding="12,0">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="GoldMarker" Width="4" Height="28" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" CornerRadius="2" Background="{StaticResource RoGoldBrush}"
                                    Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#FFE4EFFC" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#FFD1E2FA" />
                                <Setter TargetName="NavBorder" Property="BorderBrush" Value="#FF6E96CE" />
                                <Setter TargetName="GoldMarker" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="#FF174E9A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="23" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Foreground" Value="{StaticResource RoBlueBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="NavIconStyle" TargetType="Image">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource RoHeadingFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,5,10,5" />
        </Style>
        <Style x:Key="FieldEditorStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,14,4" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#557DB7" BorderThickness="1" Margin="5" CornerRadius="8" Background="{StaticResource RoWindowBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="86" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource RoHeaderBrush}" BorderBrush="{StaticResource RoBorderBrush}" BorderThickness="0,0,0,2"
                    CornerRadius="7,7,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="18,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Source="Assets/roaura-icon.png" Width="58" Height="58" Stretch="Uniform" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="RoAura" Style="{StaticResource RoDisplayTextStyle}" FontSize="31" />
                        <TextBlock Text="{DynamicResource Subtitle}" Style="{StaticResource RoCaptionTextStyle}" FontSize="13" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="{DynamicResource Server}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="ServerProfileBox" Width="112" Margin="0,0,14,0" SelectionChanged="ServerProfile_SelectionChanged">
                            <ComboBoxItem Content="RTM" Tag="RTM"/>
                            <ComboBoxItem Content="SpringRO" Tag="SpringRO"/>
                            <ComboBoxItem Content="Другой" Tag="Other"/>
                        </ComboBox>
                        <TextBlock Text="{DynamicResource Language}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="LanguageBox" Width="120" SelectionChanged="Language_SelectionChanged">
                            <ComboBoxItem Content="Русский" Tag="ru" />
                            <ComboBoxItem Content="English" Tag="en" />
                        </ComboBox>
                    </StackPanel>
                    <Border Grid.Column="3" Padding="12,7" VerticalAlignment="Center" Background="#DFFFFFFF" CornerRadius="5"
                            BorderBrush="{StaticResource RoSoftBorderBrush}" BorderThickness="1">
                        <TextBlock Foreground="{StaticResource RoBlueBrush}">
                            <Run Text="{Binding SettingsHotkey}" /><Run Text=" — "/><Run Text="{DynamicResource SettingsShort}" />
                            <Run Text=" · "/><Run Text="{Binding OverlaysHotkey}" /><Run Text=" — "/><Run Text="{DynamicResource OverlaysShort}" />
                        </TextBlock>
                    </Border>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Top">
                        <Button Content="—" ToolTip="Свернуть" Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeWindow_Click"/>
                        <Button x:Name="MaximizeWindowButton" Content="□" ToolTip="Развернуть" Style="{StaticResource TitleBarButtonStyle}"
                                Click="ToggleMaximizeWindow_Click"/>
                        <Button Content="×" ToolTip="Закрыть" Style="{StaticResource DangerButtonStyle}" Width="36" Height="30"
                                MinHeight="30" Padding="0" FontSize="18" Click="CloseWindow_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="9,8,9,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="215" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#EFFFFFFF" BorderBrush="{StaticResource RoSoftBorderBrush}" BorderThickness="1" CornerRadius="7">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Margin="2,8">
                            <RadioButton x:Name="CooldownNavButton" Tag="0" Style="{StaticResource NavigationButtonStyle}" Checked="Navigation_Checked">
                                <StackPanel Orientation="Horizontal"><Image Source="Assets/Menu/01_cooldowns.png" Style="{StaticResource NavIconStyle}"/><TextBlock Text="{DynamicResource Cooldowns}" VerticalAlignment="Center"/></StackPanel>
                            </RadioButton>
                            <RadioButton Tag="1" Style="{StaticResource NavigationButtonStyle}" Checked="Navigation_Checked">
                                <StackPanel Orientation="Horizontal"><Image Source="Assets/Menu/02_buffs_debuffs.png" Style="{StaticResource NavIconStyle}"/><TextBlock Text="{DynamicResource Effects}" VerticalAlignment="Center"/></StackPanel>
                            </RadioButton>
                            <RadioButton Tag="2" Style="{StaticResource NavigationButtonStyle}" Checked="Navigation_Checked">
                                <StackPanel Orientation="Horizontal"><Image Source="Assets/Menu/03_reminder.png" Style="{StaticResource NavIconStyle}"/><TextBlock Text="{DynamicResource Reminders}" VerticalAlignment="Center"/></StackPanel>
                            </RadioButton>
                            <RadioButton Tag="3" Style="{StaticResource NavigationButtonStyle}" Checked="Navigation_Checked">
                                <StackPanel Orientation="Horizontal"><Image Source="Assets/Menu/04_equipment.png" Style="{StaticResource NavIconStyle}"/><TextBlock Text="{DynamicResource Equipment}" VerticalAlignment="Center"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="MvpNavButton" Tag="4" Style="{StaticResource NavigationButtonStyle}" Checked="Navigation_Checked">
                                <StackPanel Orientation="Horizontal"><Image Source="Assets/Menu/05_mvp_timers.png" Style="{StaticResource NavIconStyle}"/><TextBlock Text="{DynamicResource MvpTimers}" VerticalAlignment="Center"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="LootNavButton" Tag="5" Style="{StaticResource NavigationButtonStyle}" Checked="Navigation_Checked">
                                <StackPanel Orientation="Horizontal"><Image Source="Assets/Menu/06_loot_zeny_exp.png" Style="{StaticResource NavIconStyle}"/><TextBlock Text="{DynamicResource LootRewards}" VerticalAlignment="Center"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="DatabaseNavButton" Tag="6" Style="{StaticResource NavigationButtonStyle}" Checked="Navigation_Checked">
                                <StackPanel Orientation="Horizontal"><Image Source="Assets/Menu/05_mvp_timers.png" Style="{StaticResource NavIconStyle}"/><TextBlock Text="{DynamicResource Database}" VerticalAlignment="Center"/></StackPanel>
                            </RadioButton>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="9,0,9,10">
                            <Separator Margin="2,4,2,8" Background="{StaticResource RoSoftBorderBrush}"/>
                            <Button Click="About_Click" HorizontalContentAlignment="Left" Style="{StaticResource GhostButtonStyle}">
                                <StackPanel Orientation="Horizontal"><Image Source="Assets/Menu/07_about.png" Style="{StaticResource NavIconStyle}"/><TextBlock Text="{DynamicResource About}" VerticalAlignment="Center"/></StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Margin="0,0,0,7" Padding="10" BorderBrush="{StaticResource RoSoftBorderBrush}"
                    BorderThickness="1" CornerRadius="7" Background="#EFFFFFFF">
                <StackPanel>
                    <WrapPanel>
                        <CheckBox x:Name="EnabledBox" Content="{DynamicResource TrackingEnabled}" Margin="0,0,18,0" />
                    </WrapPanel>
                    <WrapPanel Margin="0,10,0,0">
                        <CheckBox Content="{DynamicResource ReadPackets}" IsChecked="{Binding PacketCaptureEnabled}" Margin="0,0,16,0" />
                        <TextBlock Text="{DynamicResource Server}" VerticalAlignment="Center" />
                        <TextBox Width="130" Margin="6,0,10,0" Text="{Binding PacketServerAddress}" />
                        <TextBlock Text="{DynamicResource Port}" VerticalAlignment="Center" />
                        <TextBox Width="66" Margin="6,0,10,0" Text="{Binding PacketServerPort}" />
                        <TextBlock Text="{DynamicResource Process}" VerticalAlignment="Center" />
                        <TextBox x:Name="ProcessesBox" Width="150" Margin="6,0,10,0" />
                        <CheckBox Content="{DynamicResource AutoDetectConnection}" IsChecked="{Binding AutoDetectConnection}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <Button Content="{DynamicResource DetectConnectionNow}" Click="AutoDetectConnection_Click" />
                        <Button Content="{DynamicResource CheckNpcap}" Click="CheckNpcap_Click" />
                        <Button Content="{DynamicResource ResetAid}" Click="ResetPacketAid_Click" />
                    </WrapPanel>
                    <Border Margin="0,8,0,0" Padding="8,5" Background="#FFEAF4FF" BorderBrush="#FFB9CEE3" BorderThickness="1">
                        <TextBlock Text="{Binding PacketCaptureStateText}" Foreground="#FF32618A" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Border>
                    <WrapPanel Margin="0,10,0,0">
                        <TextBlock Text="{DynamicResource Hotkeys}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <TextBlock Text="{DynamicResource SettingsWindowHotkey}" VerticalAlignment="Center" />
                        <ComboBox Width="78" Margin="6,0,14,0" ItemsSource="{Binding HotkeyChoices}" SelectedItem="{Binding SettingsHotkey, Mode=TwoWay}" />
                        <TextBlock Text="{DynamicResource OverlaysHotkey}" VerticalAlignment="Center" />
                        <ComboBox Width="78" Margin="6,0,14,0" ItemsSource="{Binding HotkeyChoices}" SelectedItem="{Binding OverlaysHotkey, Mode=TwoWay}" />
                        <TextBlock Text="{DynamicResource FinishMoveHotkey}" VerticalAlignment="Center" />
                        <ComboBox Width="88" Margin="6,0,14,0" ItemsSource="{Binding HotkeyChoices}" SelectedItem="{Binding FinishMoveHotkey, Mode=TwoWay}" />
                        <TextBlock Text="{DynamicResource TimersHotkey}" VerticalAlignment="Center" />
                        <ComboBox Width="78" Margin="6,0,14,0" ItemsSource="{Binding HotkeyChoices}" SelectedItem="{Binding TimersHotkey, Mode=TwoWay}" />
                        <StackPanel x:Name="DatabaseHotkeyControls" Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource DatabaseHotkey}" VerticalAlignment="Center" />
                            <ComboBox Width="78" Margin="6,0,14,0" ItemsSource="{Binding HotkeyChoices}" SelectedItem="{Binding DatabaseHotkey, Mode=TwoWay}" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource HotkeyExamples}" Foreground="{StaticResource RoMutedBrush}" VerticalAlignment="Center" />
                    </WrapPanel>
                </StackPanel>
                    </Border>

                    <TabControl x:Name="MainTabs" Grid.Row="1" Style="{StaticResource SidebarTabControlStyle}" Background="Transparent">
                <TabItem Header="{DynamicResource Cooldowns}">
                    <Grid Margin="8,4,8,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="230" MinHeight="90" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Margin="0,0,0,8" Padding="14,9" CornerRadius="7"
                                Background="#E5F0FC" BorderBrush="{StaticResource RoSoftBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource RoPrimaryButtonBrush}" Margin="0,0,10,0">
                                    <TextBlock Text="◷" Foreground="White" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{DynamicResource CooldownSettingsTitle}" Style="{StaticResource RoSectionTitleStyle}"/>
                                    <TextBlock Text="{DynamicResource CooldownSettingsHint}" Style="{StaticResource RoCaptionTextStyle}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataGrid Grid.Row="1" x:Name="SkillsGrid" ItemsSource="{Binding Skills}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="{DynamicResource On}" Binding="{Binding Enabled}" Width="45" />
                                <DataGridTextColumn Header="{DynamicResource Name}" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Skill ID" Binding="{Binding PacketSkillId}" Width="75" />
                                <DataGridTextColumn Header="CD, sec" Binding="{Binding CooldownSeconds}" Width="70" />
                                <DataGridTextColumn Header="{DynamicResource Group}" Binding="{Binding GroupNumber}" Width="65" />
                                <DataGridTextColumn Header="{DynamicResource Size}" Binding="{Binding IndividualIconSize}" Width="65" />
                                <DataGridTextColumn Header="{DynamicResource ReadyOpacity}" Binding="{Binding ReadyOpacityPercent}" Width="150" />
                                <DataGridTextColumn Header="{DynamicResource CooldownOpacity}" Binding="{Binding CooldownOpacityPercent}" Width="150" />
                                <DataGridTextColumn Header="X" Binding="{Binding X}" Width="65" />
                                <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="65" />
                                <DataGridTextColumn Header="{DynamicResource Icon}" Binding="{Binding IconStatusText}" IsReadOnly="True" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#9DB7D8" Cursor="SizeNS"/>
                        <Border Grid.Row="3" Margin="0,8,0,9" Padding="7" CornerRadius="7" Background="#F8FBFF"
                                BorderBrush="{StaticResource RoSoftBorderBrush}" BorderThickness="1">
                            <WrapPanel>
                                <Button Click="Add_Click" Style="{StaticResource PrimaryButtonStyle}"><StackPanel Orientation="Horizontal"><TextBlock Text="＋" Foreground="White" Margin="0,0,5,0"/><TextBlock Text="{DynamicResource Add}" Foreground="White"/></StackPanel></Button>
                                <Button Click="Delete_Click" Style="{StaticResource DangerButtonStyle}"><StackPanel Orientation="Horizontal"><TextBlock Text="✕" Foreground="#9A3442" Margin="0,0,5,0"/><TextBlock Text="{DynamicResource Delete}" Foreground="#9A3442"/></StackPanel></Button>
                                <Button Click="PickIcon_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Margin="0,0,5,0"/><TextBlock Text="{DynamicResource PickIcon}"/></StackPanel></Button>
                                <Button Click="LearnSkillPacket_Click" Style="{StaticResource GoldButtonStyle}"><StackPanel Orientation="Horizontal"><TextBlock Text="✦" Foreground="#684719" Margin="0,0,5,0"/><TextBlock Text="{DynamicResource LearnSkill}" Foreground="#684719"/></StackPanel></Button>
                                <Button Click="Test_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▶" Margin="0,0,5,0"/><TextBlock Text="{DynamicResource TestCooldown}"/></StackPanel></Button>
                                <ToggleButton x:Name="MoveModeButton" Checked="MoveMode_Changed" Unchecked="MoveMode_Changed"><StackPanel Orientation="Horizontal"><TextBlock Text="✥" Margin="0,0,5,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/><TextBlock Text="{DynamicResource MoveOne}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/></StackPanel></ToggleButton>
                                <ToggleButton x:Name="GroupMoveModeButton" Checked="GroupMoveMode_Changed" Unchecked="GroupMoveMode_Changed"><StackPanel Orientation="Horizontal"><TextBlock Text="✥" Margin="0,0,5,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/><TextBlock Text="{DynamicResource MoveGroup}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/></StackPanel></ToggleButton>
                                <CheckBox Content="{DynamicResource ShortNames}" IsChecked="{Binding ShowShortNames}" Margin="16,0,18,0" VerticalAlignment="Center" />
                                <CheckBox Content="{DynamicResource ReadyText}" IsChecked="{Binding ShowReadyText}" VerticalAlignment="Center" />
                            </WrapPanel>
                        </Border>
                        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <Grid DataContext="{Binding SelectedItem, ElementName=SkillsGrid}" MinWidth="920">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.05*" />
                                    <ColumnDefinition Width="1.15*" />
                                </Grid.ColumnDefinitions>
                                <GroupBox Header="{DynamicResource MainParameters}" Style="{StaticResource DetailGroupBoxStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <TextBlock Text="{DynamicResource Name}" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Grid.Column="1" Text="{Binding Name}" Style="{StaticResource FieldEditorStyle}" />
                                        <TextBlock Grid.Row="1" Text="Skill ID" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PacketSkillId}" Style="{StaticResource FieldEditorStyle}" />
                                        <TextBlock Grid.Row="2" Text="{DynamicResource CooldownSeconds}" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CooldownSeconds}" Style="{StaticResource FieldEditorStyle}" />
                                        <TextBlock Grid.Row="3" Text="{DynamicResource Group}" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding GroupNumber}" Style="{StaticResource FieldEditorStyle}" />
                                        <TextBlock Grid.Row="4" Text="{DynamicResource PositionXY}" Style="{StaticResource FieldLabelStyle}" />
                                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                            <TextBox Width="88" Text="{Binding X}" Style="{StaticResource FieldEditorStyle}" />
                                            <TextBox Width="88" Text="{Binding Y}" Style="{StaticResource FieldEditorStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>
                                <GroupBox Grid.Column="1" Header="{DynamicResource Appearance}" Style="{StaticResource DetailGroupBoxStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="175" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <TextBlock Text="{DynamicResource IconSize}" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Grid.Column="1" Text="{Binding IndividualIconSize}" Style="{StaticResource FieldEditorStyle}" />
                                        <TextBlock Grid.Row="1" Text="{DynamicResource ReadyOpacity}" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ReadyOpacityPercent}" Style="{StaticResource FieldEditorStyle}" />
                                        <TextBlock Grid.Row="2" Text="{DynamicResource CooldownOpacity}" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CooldownOpacityPercent}" Style="{StaticResource FieldEditorStyle}" />
                                        <TextBlock Grid.Row="3" Text="{DynamicResource IconPadding}" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding IconPadding}" Style="{StaticResource FieldEditorStyle}" />
                                    </Grid>
                                </GroupBox>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem Header="{DynamicResource Effects}">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="210" MinHeight="90" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="EffectsGrid" ItemsSource="{Binding Effects}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="{DynamicResource On}" Binding="{Binding Enabled}" Width="45" />
                                <DataGridTextColumn Header="{DynamicResource Name}" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Status ID" Binding="{Binding StatusId}" Width="80" />
                                <DataGridTextColumn Header="{DynamicResource Group}" Binding="{Binding GroupNumber}" Width="65" />
                                <DataGridCheckBoxColumn Header="{DynamicResource BuffPanel}" Binding="{Binding ShowOnBuffPanel}" Width="85" />
                                <DataGridTextColumn Header="X" Binding="{Binding NotificationX}" Width="65" />
                                <DataGridTextColumn Header="Y" Binding="{Binding NotificationY}" Width="65" />
                                <DataGridTextColumn Header="{DynamicResource Icon}" Binding="{Binding TemplateStatusText}" IsReadOnly="True" Width="2*" />
                                <DataGridTextColumn Header="{DynamicResource State}" Binding="{Binding CurrentStateText}" IsReadOnly="True" Width="120" />
                                <DataGridCheckBoxColumn Header="{DynamicResource Appeared}" Binding="{Binding NotifyOnAppeared}" Width="85" />
                                <DataGridCheckBoxColumn Header="{DynamicResource Disappeared}" Binding="{Binding NotifyOnDisappeared}" Width="95" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#9DB7D8" Cursor="SizeNS"/>
                        <WrapPanel Grid.Row="2" Margin="0,7,0,9">
                            <Button Content="{DynamicResource Add}" Click="AddEffect_Click" />
                            <Button Content="{DynamicResource Delete}" Click="DeleteEffect_Click" />
                            <Button Content="{DynamicResource PickIcon}" Click="PickEffectIcon_Click" />
                            <Button Content="{DynamicResource LearnStatus}" Click="LearnEffectPacket_Click" />
                            <Button Content="{DynamicResource TestAppeared}" Click="TestEffectAppeared_Click" />
                            <Button Content="{DynamicResource TestDisappeared}" Click="TestEffectDisappeared_Click" />
                            <ToggleButton x:Name="NotificationMoveModeButton" Content="{DynamicResource MoveOne}" Checked="NotificationMoveMode_Changed" Unchecked="NotificationMoveMode_Changed" />
                            <ToggleButton x:Name="NotificationGroupMoveModeButton" Content="{DynamicResource MoveGroup}" Checked="NotificationGroupMoveMode_Changed" Unchecked="NotificationGroupMoveMode_Changed" />
                            <ToggleButton x:Name="BuffPanelMoveModeButton" Content="{DynamicResource MoveBuffPanel}" Checked="BuffPanelMoveMode_Changed" Unchecked="BuffPanelMoveMode_Changed" />
                        </WrapPanel>
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding SelectedItem, ElementName=EffectsGrid}" MinWidth="960">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <GroupBox Header="{DynamicResource EventsAndSound}" Style="{StaticResource DetailGroupBoxStyle}" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="175"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <CheckBox Content="{DynamicResource NotifyAppeared}" IsChecked="{Binding NotifyOnAppeared}" Margin="0,5,10,5" />
                                            <TextBox Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding AppearedText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldEditorStyle}" Margin="0,4,0,4" />
                                            <CheckBox Grid.Row="1" Content="{DynamicResource NotifyDisappeared}" IsChecked="{Binding NotifyOnDisappeared}" Margin="0,5,10,5" />
