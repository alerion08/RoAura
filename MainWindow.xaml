                            <Border Style="{StaticResource DashboardCardStyle}" Padding="18,14"><StackPanel><TextBlock Text="{DynamicResource SessionItems}" Style="{StaticResource DashboardLabelStyle}"/><TextBlock x:Name="GoldGoblinItemCountText" Text="0" Style="{StaticResource DashboardValueStyle}" Margin="0,5,0,2"/><TextBlock Text="{DynamicResource SessionItemsHint}" Style="{StaticResource RoCaptionTextStyle}"/></StackPanel></Border>
