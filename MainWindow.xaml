                                                        <TextBlock Text="{DynamicResource QuantityPerSession}" Style="{StaticResource FieldLabelStyle}"/>
                                                        <TextBox Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldEditorStyle}"/>
