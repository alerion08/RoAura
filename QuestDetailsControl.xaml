<UserControl x:Class="RoAura.QuestDetailsControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="Arial, Segoe UI" FontSize="13" Foreground="#0D3268" Background="#F8FBFF" SizeChanged="Layout_Changed">
 <UserControl.Resources>
  <Style x:Key="SemanticPanel" TargetType="Border"><Setter Property="Background" Value="#FCFDFF"/><Setter Property="BorderBrush" Value="#D4E2F2"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/></Style>
 </UserControl.Resources>
 <Grid Margin="14,10,14,12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,6"><TextBlock x:Name="DataStatus" DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="#627C9C"/><ComboBox x:Name="ReadyChoice" SelectionChanged="Ready_Changed" DisplayMemberPath="Title" SelectedValuePath="Id" MinHeight="28"/></DockPanel>
  <Grid x:Name="Columns" Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="LeftColumn" Width="*"/><ColumnDefinition x:Name="RightColumn" Width="*"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition x:Name="TopRow" Height="*"/><RowDefinition x:Name="BottomRow" Height="0"/></Grid.RowDefinitions>
   <Border x:Name="LeftPanel" Style="{StaticResource SemanticPanel}" Margin="0,0,5,0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border BorderBrush="#E2EAF4" BorderThickness="0,0,0,1" Padding="14,13,14,12"><StackPanel>
      <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0"><Button x:Name="RuButton" Content="RU" Width="42" Height="28" Click="Ru_Click"/><Button x:Name="EnButton" Content="EN" Width="42" Height="28" Click="En_Click"/></StackPanel><TextBlock x:Name="QuestTitle" FontFamily="Georgia" FontSize="19" FontWeight="Bold" Foreground="#103B77" TextWrapping="Wrap"/></DockPanel>
      <TextBlock x:Name="Metadata" FontSize="11" Foreground="#627C9C" TextWrapping="Wrap" Margin="0,4,0,4"/>
      <TextBlock x:Name="Quality" FontSize="11" TextWrapping="Wrap" Foreground="#627C9C"/>
      <WrapPanel Margin="0,10,0,0"><Button x:Name="AddButton" Click="Add_Click" Height="31" Margin="0,0,8,0"/><Button x:Name="GoCurrentButton" Click="Current_Click" Height="31"/></WrapPanel>
      <WrapPanel Margin="0,10,0,0"><TextBlock x:Name="ProgressText" FontSize="11" Foreground="#627C9C"/><ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="1" Height="5" Width="125" Margin="10,5,0,0" Foreground="#328B50" Background="#DCE8F6"/></WrapPanel>
     </StackPanel></Border>
     <ScrollViewer x:Name="WalkScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="StepsPanel" Margin="10,7,10,12"/></ScrollViewer>
    </Grid>
   </Border>
   <Border x:Name="RightPanel" Grid.Column="1" Style="{StaticResource SemanticPanel}" Margin="5,0,0,0">
    <TabControl x:Name="DetailsTabs" Style="{StaticResource EditorTabControlStyle}">
     <TabItem x:Name="WalkTab"><ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="DetailPanel" Margin="12"/></ScrollViewer></TabItem>
     <TabItem x:Name="FactsTab"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="FactsPanel" Margin="12"/></ScrollViewer></TabItem>
     <TabItem x:Name="SourcesTab"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SourcePanel" Margin="12"/></ScrollViewer></TabItem>
    </TabControl>
   </Border>
  </Grid>
  <Border x:Name="Toast" Grid.RowSpan="2" Background="#1E426E" CornerRadius="6" Padding="15,11" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed" IsHitTestVisible="False" MaxWidth="350"><TextBlock x:Name="ToastText" Foreground="White" TextWrapping="Wrap"/></Border>
 </Grid>
</UserControl>
