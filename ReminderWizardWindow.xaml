<Window x:Class="RoAura.ReminderWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AddReminder}" Width="760" Height="590"
        MinWidth="680" MinHeight="540" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" ShowInTaskbar="False" Background="{StaticResource RoWindowBrush}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Padding="22,17" Background="White" BorderBrush="{StaticResource RoSoftBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="StepLabel" Foreground="{StaticResource RoBlueBrush}" FontWeight="Bold"/>
                <TextBlock Grid.Row="1" x:Name="TitleLabel" Style="{StaticResource RoSectionTitleStyle}" FontSize="24" Margin="0,5,0,0"/>
                <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Height="4" CornerRadius="2" Background="{StaticResource RoBlueBrush}"/><Border x:Name="ProgressStepTwo" Grid.Column="2" Height="4" CornerRadius="2" Background="#D8E2F0"/></Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="22,18">
            <Grid x:Name="FindStep">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource ReminderBehaviorHint}" Foreground="{StaticResource RoMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <Grid Grid.Row="1" Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="FindInGameCard" Padding="18" CornerRadius="8" BorderThickness="2" BorderBrush="{StaticResource RoBlueBrush}" Background="#EAF3FF" MouseLeftButtonUp="FindInGameCard_Click"><StackPanel><TextBlock Text="⌕" FontSize="25"/><TextBlock Text="{DynamicResource WizardFindInGame}" FontWeight="Bold" FontSize="15" Margin="0,8,0,0"/><TextBlock Text="{DynamicResource WizardFindInGameHint}" Foreground="{StaticResource RoMutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                    <Border x:Name="ManualIdCard" Grid.Column="2" Padding="18" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource RoSoftBorderBrush}" Background="#F8FBFF" MouseLeftButtonUp="ManualIdCard_Click"><StackPanel><TextBlock Text="#" FontSize="25"/><TextBlock Text="{DynamicResource WizardManualId}" FontWeight="Bold" FontSize="15" Margin="0,8,0,0"/><TextBlock Text="{DynamicResource WizardManualIdHint}" Foreground="{StaticResource RoMutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                </Grid>
                <Border Grid.Row="2" Padding="14" CornerRadius="7" Background="#EDF4FD" BorderBrush="{StaticResource RoSoftBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid x:Name="FindInGameArea"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource WizardSearchInstruction}" TextWrapping="Wrap" VerticalAlignment="Center"/><Button Grid.Column="1" Content="{DynamicResource WizardStartSearch}" Click="StartSearch_Click" Style="{StaticResource GoldButtonStyle}"/></Grid>
                        <Grid x:Name="ManualIdArea" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Status ID" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Draft.StatusId, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="3" Margin="4,12,4,0"><Border Padding="12,8" Margin="0,0,0,8" CornerRadius="7" Background="#E3F5EB" BorderBrush="#A7DCC0" BorderThickness="1"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Draft.StatusId}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Foreground="#24734A" FontWeight="SemiBold"><Run Text="{DynamicResource WizardDetectedStatus}"/><Run Text=" "/><Run Text="{Binding Draft.StatusId}"/></TextBlock></Border><TextBlock x:Name="ValidationText" Foreground="#B64B55" TextWrapping="Wrap"/></StackPanel>
            </Grid>

            <Grid x:Name="SetupStep" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource ReminderWizardSetupHint}" Foreground="{StaticResource RoMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,15"/>
                    <TextBlock Text="{DynamicResource Name}" FontWeight="SemiBold"/><TextBox Text="{Binding Draft.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12"/>
                    <TextBlock Text="{DynamicResource ReminderText}" FontWeight="SemiBold"/><TextBox Text="{Binding Draft.Text, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12"/>
                    <TextBlock Text="{DynamicResource Group}" FontWeight="SemiBold"/><TextBox Text="{Binding Draft.GroupNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12"/>
                    <Button Content="{DynamicResource PickIcon}" Click="PickIcon_Click" HorizontalAlignment="Left"/>
                    <CheckBox Content="{DynamicResource TrackReminder}" IsChecked="{Binding Draft.Enabled}" Margin="0,14,0,0"/>
                    <TextBlock x:Name="SetupValidationText" Foreground="#B64B55" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" Padding="14" CornerRadius="8" Background="#1E3150">
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource ReminderPreview}" Foreground="#C5D4EA" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,12"/><Border Width="96" Height="96" Padding="{Binding Draft.IconPadding, Converter={StaticResource PreviewPadding}}" CornerRadius="8" BorderThickness="1" BorderBrush="{Binding Draft.BorderColor}" Background="{Binding Draft.BackgroundColor}" HorizontalAlignment="Center"><Image Source="{Binding Draft.IconImageBase64, Converter={StaticResource Base64Image}}" Stretch="UniformToFill"/></Border><TextBlock Text="{Binding Draft.Text}" Foreground="{Binding Draft.TextColor}" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" Margin="4,10,4,0"/></StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Padding="18,12" Background="White" BorderBrush="{StaticResource RoSoftBorderBrush}" BorderThickness="0,1,0,0"><Grid><Button x:Name="BackButton" Content="{DynamicResource Back}" Click="Back_Click" Visibility="Collapsed" HorizontalAlignment="Left"/><Button x:Name="CancelButton" Content="{DynamicResource Cancel}" Click="Cancel_Click" HorizontalAlignment="Left"/><Button x:Name="NextButton" Content="{DynamicResource Continue}" Click="Next_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right"/><Button x:Name="CreateButton" Content="{DynamicResource CreateReminder}" Click="Create_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Visibility="Collapsed"/></Grid></Border>
    </Grid>
</Window>
