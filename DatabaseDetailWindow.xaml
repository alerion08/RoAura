<Window x:Class="RoAura.DatabaseDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        PreviewMouseDown="Details_PreviewMouseDown" PreviewKeyDown="Details_PreviewKeyDown"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="False"
        AllowsTransparency="True" Background="Transparent" Foreground="{DynamicResource UiForeground_17365F}" FontFamily="Trebuchet MS"
        Width="390" MinWidth="340" MinHeight="460">
    <Window.Resources>
        <Style x:Key="FarmResultButtonStyle" TargetType="Button" BasedOn="{StaticResource RoButtonBaseStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource RoSelectionBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Card" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource UiBorder_5E86BD}" BorderThickness="2" CornerRadius="9" Background="{DynamicResource UiBackground_F6F9FE}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
            <Border Background="{DynamicResource UiBackground_DCEBFA}" BorderBrush="{DynamicResource UiBorder_7DA2D1}" BorderThickness="0,0,0,2" CornerRadius="7,7,0,0">
                <DockPanel Margin="12,5">
                    <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="&#x2715;" Width="34" Height="30" MinHeight="0"
                            Margin="0" Padding="0" FontSize="15" Click="Close_Click" ToolTip="Закрыть базу данных"/>
                    <Button x:Name="BackButton" DockPanel.Dock="Right" Margin="0,0,6,0"
                            MinHeight="0" Height="30" Padding="9,0" Visibility="Collapsed" Click="Back_Click"/>
                    <TextBlock x:Name="PanelTitle" Text="Результат" FontFamily="Georgia" FontWeight="Bold" FontSize="17"
                               Foreground="{DynamicResource UiForeground_174D92}" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <Border Grid.Row="1" Margin="9,8" BorderBrush="{DynamicResource UiBorder_A9C0DD}" BorderThickness="1"
                    Background="{DynamicResource UiBackground_F8FBFF}" CornerRadius="5">
                <Grid ClipToBounds="True">
                    <Grid.RowDefinitions><RowDefinition Height="45"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <ScrollViewer x:Name="DetailsScroll" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="DetailsScroll_ScrollChanged">
                        <StackPanel x:Name="DetailsPanel" Margin="13"/>
                    </ScrollViewer>
                    <Button x:Name="FavoriteButton" HorizontalAlignment="Right" VerticalAlignment="Top" Width="34" Height="30"
                            MinHeight="0" Margin="0,12,23,0" Padding="0" FontSize="18" FontFamily="Segoe UI Symbol"
                            Visibility="Collapsed" Click="FavoriteButton_Click"/>
                    <Border x:Name="FavoriteMenu" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6,0,23,6"
                            Width="238" MaxHeight="280" Visibility="Collapsed" Padding="6" CornerRadius="7" BorderThickness="1"
                            Background="{DynamicResource RoPanelBrush}" BorderBrush="{DynamicResource RoBorderBrush}">
                        <DockPanel>
                            <Button x:Name="CreateFavoriteListButton" DockPanel.Dock="Bottom" Click="CreateFavoriteList_Click" Margin="0,4,0,0"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="FavoritePopupLists"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Row="2" Background="{DynamicResource UiBackground_E6F0FB}" BorderBrush="{DynamicResource UiBorder_A9C0DD}" BorderThickness="0,1,0,0" CornerRadius="0,0,7,7">
                <TextBlock x:Name="KeyboardStatus" Margin="9,5" Text="Ввод в поиск активен · F7 — закрыть" FontSize="10" Foreground="{DynamicResource UiForeground_8B4B5A}" TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>
    </Border>
</Window>
