<Window x:Class="RoAura.DatabaseDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="False"
        AllowsTransparency="True" Background="Transparent" Foreground="#17365F" FontFamily="Trebuchet MS"
        Width="390" MinWidth="340" MinHeight="460">
    <Border BorderBrush="#5E86BD" BorderThickness="2" CornerRadius="9" Background="#F6F9FE">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
            <Border Background="#DCEBFA" BorderBrush="#7DA2D1" BorderThickness="0,0,0,2" CornerRadius="7,7,0,0">
                <Grid Margin="12,5"><TextBlock x:Name="PanelTitle" Text="Результат" FontFamily="Georgia" FontWeight="Bold" FontSize="17" Foreground="#174D92" VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right" Content="&#x2715;" Width="34" Height="30" MinHeight="0"
                            Margin="0" Padding="0" FontSize="15" Click="Close_Click"
                            ToolTip="Закрыть базу данных"/>
                </Grid>
            </Border>
            <Border Grid.Row="1" Margin="9,8" BorderBrush="#A9C0DD" BorderThickness="1" Background="#F8FBFF" CornerRadius="5">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="DetailsPanel" Margin="13"/>
                </ScrollViewer>
            </Border>
            <Border Grid.Row="2" Background="#E6F0FB" BorderBrush="#A9C0DD" BorderThickness="0,1,0,0" CornerRadius="0,0,7,7">
                <TextBlock x:Name="KeyboardStatus" Margin="9,5" Text="Ввод в поиск активен · F7 — закрыть" FontSize="10" Foreground="#8B4B5A" TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>
    </Border>
</Window>
