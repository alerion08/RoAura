<UserControl x:Class="RoAura.Controls.CharacterScopeEditor" x:Name="ScopeRoot"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Expander IsExpanded="False" Header="{DynamicResource CharacterScopeTitle}" Margin="0,12,0,4" Padding="10">
  <StackPanel>
   <TextBlock Text="{DynamicResource CharacterScopeHint}" TextWrapping="Wrap" Foreground="{StaticResource RoMutedBrush}" Margin="0,0,0,6"/>
   <Button Content="{DynamicResource CharacterScopeAll}" Click="All_Click" HorizontalAlignment="Left" Margin="0,0,0,6"/>
   <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="Choices"><ItemsControl.ItemTemplate><DataTemplate>
    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Content="{Binding Profile.Caption}" Margin="0,3"/>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
   <TextBlock x:Name="EmptyHint" Text="{DynamicResource CharacterScopeNoCharacters}" TextWrapping="Wrap" Foreground="{StaticResource RoMutedBrush}"/>
  </StackPanel>
 </Expander>
</UserControl>
