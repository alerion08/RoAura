<Window x:Class="RoAura.SkillWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить умение" Width="620" Height="500" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F2F6FC">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock x:Name="TitleText" Text="Добавить умение" FontSize="22" FontWeight="Bold" Foreground="#20334F"/><TextBlock x:Name="SubtitleText" Text="Мастер поможет настроить новый кулдаун" Foreground="#697F98" Margin="0,3,0,14"/></StackPanel>
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,18">
            <Border x:Name="Step1Bar" Height="5" CornerRadius="3" Background="#3477C7" Margin="2"/><Border x:Name="Step2Bar" Height="5" CornerRadius="3" Background="#DCE6F1" Margin="2"/><Border x:Name="Step3Bar" Height="5" CornerRadius="3" Background="#DCE6F1" Margin="2"/><Border x:Name="Step4Bar" Height="5" CornerRadius="3" Background="#DCE6F1" Margin="2"/>
        </UniformGrid>
        <Border Grid.Row="2" Background="White" BorderBrush="#DCE6F1" BorderThickness="1" CornerRadius="12" Padding="22">
            <Grid>
                <StackPanel x:Name="Step1Panel"><TextBlock x:Name="Step1Title" Text="1. Способ определения" FontSize="17" FontWeight="Bold" Margin="0,0,0,15"/><RadioButton x:Name="DetectRadio" IsChecked="True" Margin="0,7" FontWeight="SemiBold" Content="Определить Skill ID по игровому пакету"/><TextBlock x:Name="DetectHint" Text="На следующем шаге примените умение в игре — Skill ID определяется до создания кулдауна." Foreground="#697F98" TextWrapping="Wrap" Margin="25,0,0,12"/><RadioButton x:Name="ManualRadio" Margin="0,7" FontWeight="SemiBold" Content="Указать Skill ID вручную"/></StackPanel>
                <StackPanel x:Name="Step2Panel" Visibility="Collapsed"><TextBlock x:Name="Step2Title" Text="2. Идентификатор умения" FontSize="17" FontWeight="Bold" Margin="0,0,0,15"/><TextBlock x:Name="SkillIdLabel" Text="Skill ID" FontWeight="SemiBold"/><TextBox x:Name="SkillIdBox" Height="36" Margin="0,6,0,12"/><Border Background="#E9F2FF" CornerRadius="8" Padding="12"><TextBlock x:Name="SkillIdHint" Text="Примените умение в игре. Продолжите после определения Skill ID." TextWrapping="Wrap"/></Border><Button x:Name="DetectAgainButton" Content="{DynamicResource DetectAgain}" Click="DetectAgain_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel>
                <StackPanel x:Name="Step3Panel" Visibility="Collapsed"><TextBlock x:Name="Step3Title" Text="3. Основные параметры" FontSize="17" FontWeight="Bold" Margin="0,0,0,15"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="NameLabel" Text="Название" FontWeight="SemiBold"/><TextBox x:Name="NameBox" Height="36" Margin="0,6,0,12"/></StackPanel><StackPanel Grid.Column="2"><TextBlock x:Name="CooldownLabel" Text="Время восстановления, сек" FontWeight="SemiBold"/><TextBox x:Name="CooldownBox" Text="5" Height="36" Margin="0,6,0,12"/></StackPanel><StackPanel Grid.Row="1"><TextBlock x:Name="GroupLabel" Text="Группа" FontWeight="SemiBold"/><ComboBox x:Name="GroupBox" DisplayMemberPath="Name" Height="36" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="2"><TextBlock x:Name="ShortLabel" Text="Короткое название" FontWeight="SemiBold"/><TextBox x:Name="ShortBox" MaxLength="16" Height="36" Margin="0,6,0,0"/></StackPanel></Grid></StackPanel>
                <StackPanel x:Name="Step4Panel" Visibility="Collapsed"><TextBlock x:Name="Step4Title" Text="4. Иконка и завершение" FontSize="17" FontWeight="Bold" Margin="0,0,0,15"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="88" Height="88" Background="#EDF3FB" CornerRadius="10" Padding="5"><Image x:Name="IconPreview" Stretch="Uniform"/></Border><StackPanel Grid.Column="1"><Button x:Name="ChooseIconButton" Content="Выбрать PNG" Width="150" HorizontalAlignment="Left" Click="ChooseIcon_Click"/><TextBlock x:Name="IconFileText" Text="Иконка не выбрана" Foreground="#697F98" Margin="0,10,0,0" TextWrapping="Wrap"/><CheckBox x:Name="EnabledBox" Content="Сразу включить отслеживание" IsChecked="True" Margin="0,18,0,0"/></StackPanel></Grid></StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="3" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="CancelButton" Content="Отмена" Width="100" Click="Cancel_Click"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="BackButton" Content="Назад" Width="100" IsEnabled="False" Click="Back_Click"/><Button x:Name="NextButton" Content="Далее" Width="110" Margin="8,0,0,0" Click="Next_Click" Background="#3477C7" Foreground="White"/></StackPanel></Grid>
    </Grid>
</Window>
